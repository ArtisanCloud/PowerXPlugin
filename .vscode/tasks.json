{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: go run",
      "type": "shell",
      "command": "env -u POWERX_PROXY -u POWERX_PROVIDER_MODE -u NUXT_PUBLIC_INSIDE_POWERX -u NUXT_PUBLIC_POWERX_PROVIDER_MODE go run ./cmd/plugin",
      "options": {
        "cwd": "${workspaceFolder}/skeleton/backend/go-gin",
        "env": {
          "CONFIG_PATH": "${workspaceFolder}/skeleton/backend/etc",
          "POWERX_PLUGIN_CONFIG_DIR": "${workspaceFolder}/skeleton/backend/etc",
          "POWERX_BIND_ADDR": ":8078",
          "PORT": "8078",
          "POWERX_GRPC_SERVER_PORT": "9101",
          "PX_GATEWAY_BASE_URL": "http://127.0.0.1:8077",
          "PX_GATEWAY_API_PREFIX": "/api/v1",
          "PX_GATEWAY_AUTH_SCHEME": "apikey"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Web Admin: npm dev",
      "type": "shell",
      "command": "env -u POWERX_PROXY -u POWERX_PROVIDER_MODE -u NUXT_PUBLIC_INSIDE_POWERX -u NUXT_PUBLIC_POWERX_PROVIDER_MODE npm run dev -- --host 0.0.0.0 --port 3131",
      "options": {
        "cwd": "${workspaceFolder}/skeleton/web-admin/nuxt",
        "env": {
          "NUXT_DEV_PORT": "3131",
          "NUXT_PUBLIC_API_BASE": "http://localhost:8078",
          "NUXT_PUBLIC_API_PREFIX": "/api/v1",
          "NUXT_DEV_API_PROXY": "http://127.0.0.1:8078",
          "NUXT_DEV_WS_PROXY": "ws://127.0.0.1:8078",
          "NUXT_PUBLIC_POWERX_CORE_BASE": "http://localhost:8077"
        }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Full Stack: Backend + Web Admin",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Backend: go run",
        "Web Admin: npm dev"
      ],
      "problemMatcher": []
    }
  ]
}
