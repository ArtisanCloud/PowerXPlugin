{
  "id": "com.powerx.plugins.base.template.quality_distribute",
  "version": "1.0.0",
  "name": "模板巡检与批量分发",
  "summary": "扫描模板→校验→批量克隆→更新",
  "graph": {
    "nodes": [
      { "id": "scan", "kind": "plugin", "use": "com.powerx.plugins.base.template.list" },
      { "id": "validate", "kind": "plugin", "use": "com.powerx.plugins.base.template.validate" },
      { "id": "batch-clone", "kind": "plugin", "use": "com.powerx.plugins.base.template.batch_clone" },
      { "id": "update", "kind": "plugin", "use": "com.powerx.plugins.base.template.update" }
    ],
    "edges": [
      { "from": "scan", "to": "validate" },
      { "from": "validate", "to": "batch-clone" },
      { "from": "batch-clone", "to": "update" }
    ]
  },
  "workflow_step": "contracts/exposure/workflow/template-quality-distribute.json",
  "agent_stream": {
    "path": "contracts/exposure/agent-streams/template-quality-distribute.yaml",
    "intent": "template.quality_distribute",
    "summary": "巡检、克隆、更新事件推送"
  },
  "agent_tools": [
    {
      "id": "base.template.list",
      "capability_id": "com.powerx.plugins.base.template.list",
      "name": "列出模板",
      "description": "按过滤条件获取模板列表。",
      "transport": "http",
      "endpoint": "/api/v1/templates",
      "method": "GET",
      "input_schema": "contracts/schema/input/com.powerx.plugins.base.template.list.json",
      "output_schema": "contracts/schema/output/com.powerx.plugins.base.template.list.json"
    },
    {
      "id": "base.template.validate",
      "capability_id": "com.powerx.plugins.base.template.validate",
      "name": "模板巡检",
      "description": "运行一组规则校验模板。",
      "transport": "http",
      "endpoint": "/api/v1/templates/{id}/validate",
      "method": "POST",
      "input_schema": "contracts/schema/input/com.powerx.plugins.base.template.validate.json",
      "output_schema": "contracts/schema/output/com.powerx.plugins.base.template.validate.json"
    },
    {
      "id": "base.template.batch_clone",
      "capability_id": "com.powerx.plugins.base.template.batch_clone",
      "name": "批量克隆模板",
      "description": "批量生成模板副本。",
      "transport": "http",
      "endpoint": "/api/v1/templates/batch-clone",
      "method": "POST",
      "input_schema": "contracts/schema/input/com.powerx.plugins.base.template.batch_clone.json",
      "output_schema": "contracts/schema/output/com.powerx.plugins.base.template.batch_clone.json"
    }
  ]
}
