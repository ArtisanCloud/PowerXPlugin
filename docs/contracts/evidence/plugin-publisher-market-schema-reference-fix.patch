+package admission
+
+import "testing"
+
+func TestSchemaIDIsNotAResourcePath(t *testing.T) {
+	x := &index{files: map[string]*entry{"contracts/schema/input/fixture.json": {name: "contracts/schema/input/fixture.json"}}, dirs: map[string]bool{}}
+	doc := map[string]any{"provides": []any{map[string]any{"id": "schema/input/fixture.v1", "path": "schema/input/fixture.json"}}}
+	if err := references(x, doc); err != nil {
+		t.Fatal("schema_identity_treated_as_path", err)
+	}
+	delete(x.files, "contracts/schema/input/fixture.json")
+	if err := references(x, doc); err == nil {
+		t.Fatal("missing_resource_path_accepted")
+	}
+}
