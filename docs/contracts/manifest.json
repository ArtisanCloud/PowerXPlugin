{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PowerX Plugin Manifest",
  "type": "object",
  "required": ["id", "name"],
  "$defs": {
    "menu": {
      "type": "object",
      "required": ["path", "title"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/_p/[a-z0-9.-]+/admin(/.*)?$"
        },
        "title": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/menu"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "notification_presentations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "business_type",
          "contract",
          "presentation_path",
          "preview_path"
        ],
        "properties": {
          "business_type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,256}$"
          },
          "contract": {
            "enum": ["business_notification_card.v1", "business_notification_card.v2"]
          },
          "presentation_path": {
            "type": "string",
            "pattern": "^/admin/(?:[A-Za-z0-9_-]|\\{delivery_key\\})+(?:/(?:[A-Za-z0-9_-]|\\{delivery_key\\})+)*$",
            "allOf": [
              {
                "pattern": "\\{delivery_key\\}"
              },
              {
                "not": {
                  "pattern": "\\{delivery_key\\}.*\\{delivery_key\\}"
                }
              }
            ]
          },
          "preview_path": {
            "type": "string",
            "pattern": "^/admin/(?:[A-Za-z0-9_-]|\\{delivery_key\\}|\\{image_key\\})+(?:/(?:[A-Za-z0-9_-]|\\{delivery_key\\}|\\{image_key\\})+)*$",
            "allOf": [
              {
                "pattern": "\\{delivery_key\\}"
              },
              {
                "not": {
                  "pattern": "\\{delivery_key\\}.*\\{delivery_key\\}"
                }
              },
              {
                "pattern": "\\{image_key\\}"
              },
              {
                "not": {
                  "pattern": "\\{image_key\\}.*\\{image_key\\}"
                }
              }
            ]
          }
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$",
      "description": "插件唯一 ID，例如 com.powerx.sample"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "menus": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/menu"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9.-]+\\.[a-z0-9.-]+\\.[a-z0-9.-]+$"
      }
    }
  },
  "additionalProperties": false
}
