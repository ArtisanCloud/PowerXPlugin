+package ai
+
+import (
+	"context"
+	"strings"
+
+	"github.com/ArtisanCloud/PowerX/pkg/corex/iam/reqctx"
+)
+
+// settingsCatalog 复用底座 AI Settings 的目录服务；租户环境和连接信息
+// 只从底座配置解析，不接受调用方传入 endpoint、env 或凭据。
+func (i *MediaInvoker) settingsCatalog(ctx context.Context, capabilityID string, op MediaCatalogOperation) (map[string]any, error) {
+	providers := op.Operation == "list_settings_providers"
+	if op.Modality != "llm" || op.Capability != "" ||
+		(providers && (capabilityID != "com.corex.ai.catalog.providers.read" || op.Provider != "" || op.App != "")) ||
+		(!providers && (op.Operation != "list_settings_models" || capabilityID != MediaCatalogCapability || strings.TrimSpace(op.Provider) == "")) {
+		return nil, MediaError(400, "AI_OPERATION_INVALID")
+	}
+	s := i.Service.ai
+	tenant := reqctx.GetTenantUUID(ctx)
+	env, ok, err := s.ResolveTenantEnv(ctx, tenant)
+	if err != nil {
+		return nil, err
+	}
+	if !ok {
+		return nil, MediaError(409, "AI_ENV_NOT_CONFIGURED")
+	}
+	result := map[string]any{"contract_version": 1, "catalog_kind": "ai_settings", "env": env, "modality": "llm"}
+	list := s.settings.Providers("llm")
+	if providers {
+		items := make([]map[string]any, 0, len(list))
+		for _, provider := range list {
+			apps := make([]map[string]string, 0, len(provider.Apps))
+			for _, app := range provider.Apps {
+				apps = append(apps, map[string]string{"id": app.ID, "name": app.Name})
+			}
+			items = append(items, map[string]any{"id": provider.ID, "name": provider.Name, "apps": apps})
+		}
+		result["providers"] = items
+		return map[string]any{"result": result}, nil
+	}
+	found, appFound := false, op.App == ""
+	for _, provider := range list {
+		if provider.ID != op.Provider {
+			continue
+		}
+		found = true
+		for _, app := range provider.Apps {
+			if app.ID == op.App {
+				appFound = true
+			}
+		}
+	}
+	if !found || !appFound {
+		return nil, MediaError(422, "AI_MODEL_CAPABILITY_UNSUPPORTED")
+	}
+	models, err := s.settings.ModelsForTenant(ctx, env, &tenant, "llm", op.Provider, op.App, "")
+	if err != nil {
+		return nil, err
+	}
+	items := make([]map[string]string, 0, len(models))
+	for _, model := range models {
+		key := op.Provider + "/" + model
+		if op.App != "" {
+			key = op.Provider + "/" + op.App + ":" + model
+		}
+		items = append(items, map[string]string{"model_key": key, "provider": op.Provider, "model": model, "label": model})
+	}
+	result["provider"], result["app"], result["items"] = op.Provider, op.App, items
+	return map[string]any{"result": result}, nil
+}
