+package ai
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	am "github.com/ArtisanCloud/PowerX/internal/server/agent/persistence/model"
+	cap "github.com/ArtisanCloud/PowerX/internal/service/capability_registry"
+	"github.com/stretchr/testify/require"
+	"gorm.io/datatypes"
+)
+
+func TestSettingsCatalogTypedBindingReadsAISettingsProviderService(t *testing.T) {
+	f := newMediaFixture(t)
+	i := &MediaInvoker{Service: f.s}
+	body := map[string]any{"operation": "list_settings_providers", "modality": "llm"}
+	input := cap.CoreCapabilityInvokeInput{CapabilityID: "com.corex.ai.catalog.providers.read", TenantUUID: mediaTestTenant, Method: "INVOKE", Endpoint: MediaCatalogEndpoint, Body: body, Payload: map[string]any{"body": body}}
+	out, err := i.InvokeCoreCapability(f.ctx, input)
+	require.NoError(t, err)
+	result := out["result"].(map[string]any)
+	require.Equal(t, "ai_settings", result["catalog_kind"])
+	require.Equal(t, "dev", result["env"])
+	expected := map[string]string{}
+	for _, p := range f.s.ai.settings.Providers("llm") {
+		expected[p.ID] = p.Name
+	}
+	actual := map[string]string{}
+	for _, p := range result["providers"].([]map[string]any) {
+		actual[p["id"].(string)] = p["name"].(string)
+	}
+	require.Equal(t, expected, actual)
+	body["env"] = "other-environment"
+	_, err = i.InvokeCoreCapability(f.ctx, input)
+	require.ErrorContains(t, err, "AI_OPERATION_INVALID")
+}
+
+func TestSettingsCatalogTypedBindingUsesCoreOllamaInstanceWithoutStaticFallback(t *testing.T) {
+	f := newMediaFixture(t)
+	status := http.StatusOK
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(status)
+		if r.URL.Path == "/api/tags" {
+			_ = json.NewEncoder(w).Encode(map[string]any{"models": []map[string]string{{"name": "private-instance:14b"}}})
+		} else {
+			_ = json.NewEncoder(w).Encode(map[string]any{"capabilities": []string{"completion"}})
+		}
+	}))
+	defer server.Close()
+	require.NoError(t, f.s.ai.settings.SaveCredentialOnly(f.ctx, "dev", ptr(mediaTestTenant), &am.AIProviderCredential{Name: "dev-ollama", Provider: "ollama", Data: datatypes.JSONMap{"base_url": server.URL}}))
+	i := &MediaInvoker{Service: f.s}
+	body := map[string]any{"operation": "list_settings_models", "modality": "llm", "provider": "ollama", "app": ""}
+	input := cap.CoreCapabilityInvokeInput{CapabilityID: MediaCatalogCapability, TenantUUID: mediaTestTenant, Method: "INVOKE", Endpoint: MediaCatalogEndpoint, Body: body, Payload: map[string]any{"body": body}}
+	out, err := i.InvokeCoreCapability(f.ctx, input)
+	require.NoError(t, err)
+	items := out["result"].(map[string]any)["items"].([]map[string]string)
+	require.Equal(t, []map[string]string{{"model_key": "ollama/private-instance:14b", "provider": "ollama", "model": "private-instance:14b", "label": "private-instance:14b"}}, items)
+	status = http.StatusServiceUnavailable
+	out, err = i.InvokeCoreCapability(f.ctx, input)
+	require.Nil(t, out)
+	require.ErrorContains(t, err, "AI_MODEL_DISCOVERY_UPSTREAM_FAILED")
+	status = http.StatusOK
+	body["base_url"] = server.URL
+	_, err = i.InvokeCoreCapability(f.ctx, input)
+	require.ErrorContains(t, err, "AI_OPERATION_INVALID")
+}
