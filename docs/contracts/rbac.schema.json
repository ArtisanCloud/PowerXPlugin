{
  "pluginId": "com.powerx.plugins.base",
  "roles": [
    {
      "name": "powerx.plugins.base.admin",
      "description": "Plugin administrators inherit host IAM context",
      "permissions": [
        "iam.tenant.read",
        "iam.tenant.write",
        "iam.department.read",
        "iam.department.write",
        "iam.department.delete",
        "iam.user.read",
        "iam.user.write",
        "iam.role.read",
        "iam.role.write",
        "iam.role.delete",
        "iam.permission.read",
        "iam.audit.read",
        "iam.sts.mint"
      ]
    }
  ],
  "defaultAssignments": [
    {
      "hostRole": "powerx.admin",
      "pluginRole": "powerx.plugin.base.admin"
    }
  ]
}
