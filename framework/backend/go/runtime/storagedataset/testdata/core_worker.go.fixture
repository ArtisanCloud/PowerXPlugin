// This file is overlaid alongside Core's owned integration fixture.
func exerciseFrameworkDataset(t *testing.T, ctx context.Context, sourceDB *gorm.DB,
	call func(string, string, string, any, int) []byte, server *httptest.Server, tables datasetFixtureTables,
	installation pm.Plugin, schema, role, cluster, sourceDSN, path, tenant, sts, otherTenantSTS, root, target string,
	binding uuid.UUID, fixture gov.DatasetView, pause func(),
) string {
	t.Helper()
	require.NoError(t, sourceDB.Exec("ALTER TABLE "+tables.reports+" ADD COLUMN root_uuid uuid NOT NULL UNIQUE DEFAULT gen_random_uuid()").Error)
	require.NoError(t, sourceDB.Exec("ALTER ROLE "+role+" LOGIN").Error)
	ledger := schema + ".powerx_dataset_source_batches"
	require.NoError(t, sourceDB.Transaction(func(tx *gorm.DB) error {
		if err := tx.Exec("SET LOCAL search_path TO " + schema + ", pg_catalog").Error; err != nil {
			return err
		}
		return tx.Exec(datasetfw.SourceLedgerMigration()).Error
	}))
	require.NoError(t, sourceDB.Exec("GRANT DELETE ON "+tables.reports+", "+tables.assertions+" TO "+role).Error)
	require.NoError(t, sourceDB.Exec("GRANT SELECT,INSERT,UPDATE ON "+ledger+" TO "+role).Error)
	require.NoError(t, sourceDB.Exec("CREATE TABLE "+schema+".outside_dataset (id uuid)").Error)

	cfg, err := pgx.ParseConfig(sourceDSN)
	require.NoError(t, err)
	cfg.User = role
	workerDB := stdlib.OpenDB(*cfg)
	t.Cleanup(func() { require.NoError(t, workerDB.Close()) })
	_, err = workerDB.ExecContext(ctx, "SELECT * FROM "+schema+".outside_dataset")
	require.ErrorContains(t, err, "permission denied")
	insertReport := func(id int) {
		require.NoError(t, sourceDB.Exec("INSERT INTO "+tables.reports+
			" (id,tenant_uuid,finished_at,case_key,expected_assertions,format_version) VALUES (?, ?, NOW()-INTERVAL '45 days', ?, 2, 1)", id, tenant, id).Error)
		require.NoError(t, sourceDB.Exec("INSERT INTO "+tables.assertions+" VALUES (?, ?, 1), (?, ?, 2)", tenant, id, tenant, id).Error)
	}
	insertReport(100)

	index := map[string]any{}
	for key, item := range installation.DataLifecycle {
		index[key] = map[string]any{"sha256": item.SHA256, "observation_tables": item.Tables}
	}
	manifest, err := json.Marshal(map[string]any{"id": installation.ID, "data_lifecycle": index})
	require.NoError(t, err)
	require.NoError(t, os.WriteFile(filepath.Join(installation.Paths.Root, "plugin.yaml"), manifest, 0600))
	assets, err := datasetfw.LoadAssets(installation.Paths.Root)
	require.NoError(t, err)
	require.Len(t, assets, 2)
	var asset datasetfw.Asset
	for _, item := range assets {
		if item.Key() == "fixture_report" {
			asset = item
		}
	}

	token := datasetFrameworkSTS(sts)
	client := server.Client()
	fault := &datasetFrameworkFault{upstream: client.Transport}
	host, err := fwgateway.NewClient(fwgateway.Config{BaseURL: server.URL, APIPrefix: "/custom/v2", AuthScheme: "bearer",
		TenantUUID: tenant, TokenProvider: token.Token, HTTPClient: &http.Client{Transport: fault, Timeout: 10 * time.Second}})
	require.NoError(t, err)
	sdk, err := datasetfw.NewClient(host, tenant)
	require.NoError(t, err)
	registered, err := sdk.Register(ctx, uuid.NewString(), asset)
	require.NoError(t, err)
	require.Equal(t, fixture.DatasetUUID.String(), registered.DatasetUUID)
	require.Equal(t, "accepted", registered.State)
	call("GET", path, otherTenantSTS, nil, 403)

	queue, err := fwqueue.NewHostProvider(fwqueue.HostProviderConfig{BaseURL: server.URL, APIPrefix: "/custom/v2", AuthScheme: "bearer",
		TenantUUID: tenant, TokenProvider: token, HTTPClient: client})
	require.NoError(t, err)
	workerFor := func(adapter datasetFrameworkAdapter) *datasetfw.Worker {
		value, err := datasetfw.NewWorker(sdk, queue, datasetfw.Installation{DeploymentID: "owned", PluginID: installation.ID, Revision: installation.Revision},
			[]datasetfw.Dataset{{Asset: asset, Binding: datasetfw.Binding{UUID: binding.String(), ClusterID: cluster,
				Schema: schema, WorkerRole: role, DB: workerDB}, Adapter: adapter}})
		require.NoError(t, err)
		return value
	}
	adapter := datasetFrameworkAdapter{tables: tables}
	worker := workerFor(adapter)
	receive := func(worker *datasetfw.Worker, subscriber string) error {
		for i := 0; i < 4; i++ {
			found, err := worker.ReceiveAndHandle(ctx, subscriber, 500*time.Millisecond)
			if err != nil || found {
				return err
			}
		}
		t.Fatal("missing reserved TaskBus delivery")
		return nil
	}
	leaseExecution := func() fwqueue.Message {
		for i := 0; i < 4; i++ {
			messages, err := queue.Dequeue(ctx, fwqueue.DequeueRequest{TenantKey: tenant, SubscriberID: datasetfw.ExecutionSubscriber,
				MaxItems: 1, WaitTimeout: 500 * time.Millisecond})
			require.NoError(t, err)
			if len(messages) == 1 {
				require.NotNil(t, messages[0].Lease)
				return messages[0]
			}
		}
		t.Fatal("missing execution lease")
		return fwqueue.Message{}
	}
	awaitExpiry := func(message fwqueue.Message) {
		timer := time.NewTimer(time.Until(message.Lease.ExpiresAt) + 100*time.Millisecond)
		defer timer.Stop()
		select {
		case <-ctx.Done():
			t.Fatal(ctx.Err())
		case <-timer.C:
		}
	}
	preview := func() string {
		request := uuid.NewString()
		call("POST", path+"/previews", root, gov.DatasetPreviewInput{RequestUUID: request, TenantUUID: tenant,
			RetentionDays: 30, AcceptanceRevision: fixture.AcceptanceRevision}, 202)
		require.NoError(t, receive(worker, datasetfw.PreviewSubscriber))
		data := call("GET", path+"/previews/"+request, root, nil, 200)
		require.Contains(t, string(data), `"state":"completed"`)
		require.Contains(t, string(data), `"reason":"referenced"`)
		require.Contains(t, string(data), `"reason":"incomplete_record"`)
		return request
	}
	policyPath := path + "/policies/" + tenant
	policy := func(revision int, action, target string) {
		in := map[string]any{"expected_revision": revision, "acceptance_revision": fixture.AcceptanceRevision,
			"enabled": true, "action": action, "retention_days": 30}
		if target != "" {
			in["archive_target_uuid"] = target
		}
		require.Contains(t, string(call("PUT", policyPath, root, in, 200)), `"state":"enabled"`)
	}
	dispatch := func(previewID string, revision int64) string {
		request := uuid.NewString()
		call("POST", path+"/runs", root, gov.DatasetRunInput{RequestUUID: request, TenantUUID: tenant, PreviewUUID: previewID, PolicyRevision: revision}, 202)
		return request
	}
	count := func(table, where string, args ...any) int64 {
		var n int64
		require.NoError(t, sourceDB.Table(table).Where(where, args...).Count(&n).Error)
		return n
	}
	sourceContents := func() map[string][]string {
		contents := make(map[string][]string, 3)
		for _, table := range []string{tables.reports, tables.assertions, tables.refs} {
			var rows []string
			require.NoError(t, sourceDB.WithContext(ctx).Raw("SELECT row_to_json(r)::text FROM "+
				table+" AS r ORDER BY 1").Scan(&rows).Error)
			require.NotEmpty(t, rows, table)
			contents[table] = rows
		}
		return contents
	}

	before := count(tables.reports, "tenant_uuid = ?", tenant)
	beforePreview := sourceContents()
	var originalPreview []byte
	fault.operation, fault.forward = "report_preview", true
	fault.afterSuccess = func(input json.RawMessage) {
		var report datasetfw.PreviewReport
		require.NoError(t, json.Unmarshal(input, &report))
		originalPreview = call("GET", path+"/previews/"+report.RequestUUID, root, nil, 200)
		require.Contains(t, string(originalPreview), `"state":"completed"`)
	}
	previewID := preview()
	require.Len(t, fault.messages, 2)
	require.Equal(t, fault.messages[0], fault.messages[1])
	require.JSONEq(t, string(originalPreview), string(call("GET", path+"/previews/"+previewID, root, nil, 200)))
	require.Equal(t, beforePreview, sourceContents())
	fault.operation, fault.forward, fault.messages, fault.afterSuccess = "", false, nil, nil
	t.Logf("T177 SDK replay verified source=%s: Core persisted before response loss, identical replay and unchanged rows in three source tables", cluster)
	policy(0, "delete", "")
	request := dispatch(previewID, 1)
	// The report was eligible at preview time. A writer adds a reference
	// under the guard shared with the delete adapter before source execution.
	require.NoError(t, sourceDB.Transaction(func(tx *gorm.DB) error {
		if err := tx.Exec("SELECT pg_advisory_xact_lock(hashtextextended(?,0))", tenant).Error; err != nil {
			return err
		}
		return tx.Exec("INSERT INTO "+tables.refs+" VALUES (?, 3)", tenant).Error
	}))
	fault.operation = "report_execution"
	message := leaseExecution()
	require.ErrorContains(t, worker.Handle(ctx, message), "injected execution response loss")
	require.EqualValues(t, 0, count(tables.reports, "id = 100"))
	require.EqualValues(t, 0, count(tables.assertions, "report_id = 100"))
	require.EqualValues(t, 1, count(tables.reports, "tenant_uuid = ? AND id = 2", tenant))
	require.EqualValues(t, 1, count(tables.reports, "tenant_uuid = ? AND id = 3", tenant))
	require.EqualValues(t, 1, count(tables.reports, "id = 8"))
	after := count(tables.reports, "tenant_uuid = ?", tenant)
	require.Less(t, after, before)
	require.Contains(t, string(call("PUT", policyPath, root, map[string]any{"expected_revision": 1, "enabled": false}, 200)), `"state":"draining"`)
	awaitExpiry(message)
	require.Contains(t, string(call("GET", path+"/runs/"+request, root, nil, 200)), `"state":"needs_reconciliation"`)
	fresh := workerFor(adapter)
	recovered, err := fresh.RecoverPending(ctx, 10)
	require.NoError(t, err)
	require.Equal(t, 1, recovered)
	require.Len(t, fault.messages, 2)
	require.JSONEq(t, string(fault.messages[0]), string(fault.messages[1]))
	require.Contains(t, string(call("GET", path+"/runs/"+request, root, nil, 200)), fmt.Sprintf(`"affected_count":%d`, before-after))
	require.Contains(t, string(call("GET", policyPath, root, nil, 200)), `"state":"paused"`)
	_, err = workerDB.ExecContext(ctx, "UPDATE "+ledger+" SET affected_count=0 WHERE request_uuid=$1", request)
	require.ErrorContains(t, err, "DATASET_SOURCE_RECEIPT_CONFLICT")

	// Check a deferred seal rejects a late commit and rolls back the business change.
	late, err := workerDB.BeginTx(ctx, nil)
	require.NoError(t, err)
	defer late.Rollback()
	_, err = late.ExecContext(ctx, "DELETE FROM "+tables.reports+" WHERE tenant_uuid=$1 AND id=2", tenant)
	require.NoError(t, err)
	lateID := uuid.NewString()
	_, err = late.ExecContext(ctx, "INSERT INTO "+ledger+` (deployment_id,request_uuid,grant_uuid,plugin_id,installation_revision,
		tenant_uuid,source_binding_uuid,deadline_at,grant_snapshot)
		VALUES ('owned',$1,$2,$3,$4,$5,$6,clock_timestamp()-interval '1 second','{}')`, lateID, uuid.NewString(), installation.ID, installation.Revision, tenant, binding.String())
	require.NoError(t, err)
	_, err = late.ExecContext(ctx, "UPDATE "+ledger+" SET outcome='committed',source_receipt_uuid=$1,affected_count=1 WHERE request_uuid=$2", uuid.NewString(), lateID)
	require.NoError(t, err)
	require.ErrorContains(t, late.Commit(), "DATASET_DEADLINE_EXCEEDED")
	require.EqualValues(t, 1, count(tables.reports, "tenant_uuid = ? AND id = 2", tenant))

	if target != "" {
		insertReport(101)
		archivePreview := preview()
		policy(2, "archive", target)
		archive := dispatch(archivePreview, 3)
		fault.operation, fault.forward, fault.messages = "archive_execution", true, nil
		require.Error(t, receive(worker, datasetfw.ExecutionSubscriber))
		require.Len(t, fault.messages, 1)
		require.EqualValues(t, 1, count(ledger, "request_uuid = ? AND archive_bytes IS NOT NULL AND NOT delivered", archive))
		var input struct {
			Archive []byte `json:"archive_base64"`
		}
		require.NoError(t, json.Unmarshal(fault.messages[0], &input))
		require.Contains(t, string(input.Archive), `"fixture_case":101`)
		require.EqualValues(t, 1, count(tables.reports, "id = 101"))
		require.NoError(t, sourceDB.Exec("UPDATE "+tables.reports+" SET format_version=2 WHERE id=101").Error)
		recovered, err = fresh.RecoverPending(ctx, 10)
		require.NoError(t, err)
		require.Equal(t, 1, recovered)
		require.Len(t, fault.messages, 2)
		require.JSONEq(t, string(fault.messages[0]), string(fault.messages[1]))
		require.Equal(t, input.Archive, call("GET", path+"/runs/"+archive+"/archive", root, nil, 200))
		require.EqualValues(t, 1, count(ledger, "request_uuid = ? AND archive_bytes IS NULL AND delivered AND length(archive_sha256) = 64", archive))
		require.EqualValues(t, 1, count(tables.reports, "id = 101"))
	}

	insertReport(102)
	abortPreview := preview()
	revision := 2
	if target != "" {
		revision = 3
	}
	policy(revision, "delete", "")
	abort := dispatch(abortPreview, int64(revision+1))
	fault.operation = ""
	unstable := adapter
	unstable.failDelete = true
	message = leaseExecution()
	require.ErrorContains(t, workerFor(unstable).Handle(ctx, message), "injected source transaction failure")
	require.EqualValues(t, 1, count(tables.reports, "id = 102"))
	require.EqualValues(t, 2, count(tables.assertions, "report_id = 102"))
	require.EqualValues(t, 1, count(ledger, "request_uuid = ? AND outcome IS NULL", abort))
	recovered, err = fresh.RecoverPending(ctx, 10)
	require.NoError(t, err)
	require.Zero(t, recovered, "a live reservation stays open")
	awaitExpiry(message)
	recovered, err = fresh.RecoverPending(ctx, 10)
	require.NoError(t, err)
	require.Equal(t, 1, recovered)
	require.EqualValues(t, 1, count(tables.reports, "id = 102"))
	require.Contains(t, string(call("GET", path+"/runs/"+abort, root, nil, 200)), `"state":"aborted"`)

	insertReport(103)
	lostPreview := preview()
	lost := dispatch(lostPreview, int64(revision+1))
	fault.operation, fault.forward, fault.messages = "claim_execution", true, nil
	message = leaseExecution()
	require.ErrorContains(t, worker.Handle(ctx, message), "injected execution response loss")
	require.Zero(t, count(ledger, "request_uuid = ?", lost))
	require.Error(t, fresh.ReconcileExecution(ctx, lost))
	pause()
	claim := datasetfw.Claim{RequestUUID: lost, ReceiptUUID: message.Lease.ReceiptUUID, Fence: message.Lease.Fence}
	paused, err := sdk.ClaimExecution(ctx, claim)
	require.NoError(t, err)
	require.Equal(t, "reconcile_only", paused.State)
	require.Nil(t, paused.Grant)
	require.Nil(t, paused.ExpiredGrant)
	require.ErrorIs(t, fresh.Handle(ctx, message), datasetfw.ErrReconcile)
	require.Zero(t, count(ledger, "request_uuid = ?", lost))
	awaitExpiry(message)
	lostPath := path + "/runs/" + lost
	require.Contains(t, string(call("GET", lostPath, root, nil, 200)), `"state":"needs_reconciliation"`)
	require.NoError(t, ctx.Err())

	expired, err := sdk.ReconcileExecution(ctx, lost)
	require.NoError(t, err)
	require.NotNil(t, expired.ExpiredGrant)
	require.Nil(t, expired.Grant)
	require.Zero(t, count(ledger, "request_uuid = ?", lost))
	fault.operation, fault.forward, fault.messages = "report_execution", true, nil
	start := make(chan struct{})
	results := make(chan error, 2)
	readOnlySchema := adapter
	readOnlySchema.requireReadOnlySchema = true
	for _, runner := range []*datasetfw.Worker{workerFor(readOnlySchema), workerFor(readOnlySchema)} {
		go func(runner *datasetfw.Worker) {
			<-start
			results <- runner.ReconcileExecution(ctx, lost)
		}(runner)
	}
	close(start)
	failures := 0
	for i := 0; i < 2; i++ {
		if err := <-results; err != nil {
			require.ErrorContains(t, err, "injected execution response loss")
			failures++
		}
	}
	require.Equal(t, 1, failures)
	require.Len(t, fault.messages, 2)
	require.JSONEq(t, string(fault.messages[0]), string(fault.messages[1]))
	var terminal datasetfw.Report
	require.NoError(t, json.Unmarshal(fault.messages[0], &terminal))
	require.Equal(t, "aborted", terminal.Outcome)
	require.Zero(t, terminal.Affected)
	require.False(t, terminal.SourceSealedAt.Before(expired.ExpiredGrant.Deadline))
	require.NoError(t, fresh.ReconcileExecution(ctx, lost))
	require.Len(t, fault.messages, 2)
	require.EqualValues(t, 1, count(ledger, "request_uuid = ? AND outcome = 'aborted' AND delivered AND affected_count = 0", lost))
	require.Contains(t, string(call("GET", lostPath, root, nil, 200)), `"state":"aborted"`)
	require.NotContains(t, string(call("GET", policyPath, root, nil, 200)), "active_request_uuid")
	require.EqualValues(t, 1, count(tables.reports, "id = 103"))
	require.EqualValues(t, 2, count(tables.assertions, "report_id = 103"))

	t.Logf("Framework SDK verified source=%s root_delta=%d, expired reservations, paused reconciliation after a lost grant, concurrent receipt replay and archive replay", cluster, before-after)
	return path + "/previews/" + previewID
}

type datasetFrameworkSTS string

func (token datasetFrameworkSTS) Token(context.Context) (string, error) { return string(token), nil }

type datasetFrameworkFault struct {
	upstream     http.RoundTripper
	operation    string
	forward      bool
	afterSuccess func(json.RawMessage)
	messages     []json.RawMessage
	mu           sync.Mutex
}

func (f *datasetFrameworkFault) RoundTrip(req *http.Request) (*http.Response, error) {
	if f.operation == "" || req.Body == nil {
		return f.upstream.RoundTrip(req)
	}
	raw, err := io.ReadAll(req.Body)
	req.Body.Close()
	if err != nil {
		return nil, err
	}
	req.Body = io.NopCloser(bytes.NewReader(raw))
	var probe struct {
		Payload struct {
			Body struct {
				Operation string          `json:"operation"`
				Input     json.RawMessage `json:"input"`
			} `json:"body"`
		} `json:"payload"`
	}
	if json.Unmarshal(raw, &probe) != nil || probe.Payload.Body.Operation != f.operation {
		return f.upstream.RoundTrip(req)
	}
	f.mu.Lock()
	f.messages = append(f.messages, probe.Payload.Body.Input)
	first := len(f.messages) == 1
	f.mu.Unlock()
	if !first {
		return f.upstream.RoundTrip(req)
	}
	if f.forward {
		res, err := f.upstream.RoundTrip(req)
		if err != nil {
			return nil, err
		}
		io.Copy(io.Discard, res.Body)
		res.Body.Close()
		if res.StatusCode != http.StatusOK {
			return nil, fmt.Errorf("Core operation %s did not complete before response loss: %d", f.operation, res.StatusCode)
		}
		if f.afterSuccess != nil {
			f.afterSuccess(probe.Payload.Body.Input)
		}
	}
	return nil, errors.New("injected execution response loss")
}

type datasetFrameworkAdapter struct {
	tables                datasetFixtureTables
	failDelete            bool
	requireReadOnlySchema bool
}

func (a datasetFrameworkAdapter) ValidateSchema(ctx context.Context, tx datasetfw.Tx, version int64) error {
	if version != 1 {
		return datasetfw.ErrSchema
	}
	if a.requireReadOnlySchema {
		var mode string
		if err := tx.QueryRowContext(ctx, "SHOW transaction_read_only").Scan(&mode); err != nil || mode != "on" {
			return datasetfw.ErrSchema
		}
	}
	var kind string
	return tx.QueryRowContext(ctx, "SELECT pg_typeof((NULL::"+a.tables.reports+").root_uuid)::text").Scan(&kind)
}

func (a datasetFrameworkAdapter) Scan(ctx context.Context, tx datasetfw.Tx, scope datasetfw.Scope, mode datasetfw.ScanMode) (datasetfw.Scan, error) {
	if mode == datasetfw.DeleteScan {
		// The fixture reference writers use the same tenant lock.
		if _, err := tx.ExecContext(ctx, "SELECT pg_advisory_xact_lock(hashtextextended($1,0))", scope.TenantUUID); err != nil {
			return datasetfw.Scan{}, err
		}
	} else {
		var readonly string
		if err := tx.QueryRowContext(ctx, "SHOW transaction_read_only").Scan(&readonly); err != nil || readonly != "on" {
			return datasetfw.Scan{}, errors.New("source snapshot must be read only")
		}
	}
	query := "SELECT r.root_uuid::text, CASE " +
		"WHEN EXISTS (SELECT 1 FROM " + a.tables.refs + " w WHERE w.tenant_uuid=r.tenant_uuid AND w.report_id=r.id) THEN 'referenced' " +
		"WHEN r.format_version<>1 THEN 'unknown_eligibility' " +
		"WHEN (SELECT count(*) FROM " + a.tables.assertions + " c WHERE c.tenant_uuid=r.tenant_uuid AND c.report_id=r.id)<>r.expected_assertions THEN 'incomplete_record' " +
		"WHEN EXISTS (SELECT 1 FROM " + a.tables.reports + " n WHERE n.tenant_uuid=r.tenant_uuid AND n.case_key=r.case_key AND (n.finished_at,n.id)>(r.finished_at,r.id)) THEN 'latest_effective' ELSE '' END " +
		"FROM " + a.tables.reports + " r WHERE r.tenant_uuid=$1 AND r.finished_at<$2 ORDER BY r.finished_at,r.root_uuid LIMIT $3"
	rows, err := tx.QueryContext(ctx, query, scope.TenantUUID, scope.Cutoff, scope.MaxExamined+1)
	if err != nil {
		return datasetfw.Scan{}, err
	}
	defer rows.Close()
	out := datasetfw.Scan{Complete: true}
	for rows.Next() {
		if len(out.Roots) == scope.MaxExamined {
			out.Complete = false
			break
		}
		var root datasetfw.Root
		if err := rows.Scan(&root.UUID, &root.Protection); err != nil {
			return out, err
		}
		out.Roots = append(out.Roots, root)
	}
	return out, rows.Err()
}

func (a datasetFrameworkAdapter) Delete(ctx context.Context, tx datasetfw.Tx, grant datasetfw.Grant, ids []string) ([]string, error) {
	var deleted []string
	for _, id := range ids {
		var actual string
		query := "WITH removed AS (DELETE FROM " + a.tables.reports + " r WHERE r.root_uuid=$3 AND r.tenant_uuid=$1 AND r.finished_at<$2 " +
			"AND NOT EXISTS (SELECT 1 FROM " + a.tables.refs + " w WHERE w.tenant_uuid=r.tenant_uuid AND w.report_id=r.id) RETURNING r.id,r.root_uuid), " +
			"children AS (DELETE FROM " + a.tables.assertions + " WHERE tenant_uuid=$1 AND report_id IN (SELECT id FROM removed)) SELECT root_uuid::text FROM removed"
		err := tx.QueryRowContext(ctx, query, grant.TenantUUID, grant.Cutoff, id).Scan(&actual)
		if errors.Is(err, sqlpkg.ErrNoRows) {
			continue
		}
		if err != nil {
			return nil, err
		}
		deleted = append(deleted, actual)
	}
	if a.failDelete {
		return nil, errors.New("injected source transaction failure")
	}
	return deleted, nil
}

func (a datasetFrameworkAdapter) Archive(ctx context.Context, tx datasetfw.Tx, grant datasetfw.Grant, ids []string) ([]json.RawMessage, error) {
	out := make([]json.RawMessage, 0, len(ids))
	for _, id := range ids {
		var row []byte
		query := "SELECT json_build_object('root_uuid',root_uuid,'fixture_case',case_key,'version',format_version)::text " +
			"FROM " + a.tables.reports + " WHERE tenant_uuid=$1 AND finished_at<$2 AND root_uuid=$3"
		if err := tx.QueryRowContext(ctx, query, grant.TenantUUID, grant.Cutoff, id).Scan(&row); err != nil {
			return nil, err
		}
		out = append(out, row)
	}
	return out, nil
}
