{
  "name": "powerxplugin-monorepo",
  "private": true,
  "workspaces": [
    "framework/frontend/nuxt/framework-admin",
    "framework/frontend/nuxt/framework-client"
  ],
  "scripts": {
    "lint": "npm --workspaces --if-present run lint && npm --prefix skeleton/web-admin/nuxt run lint",
    "build": "npm --workspaces --if-present run build && npm --prefix skeleton/web-admin/nuxt run build",
    "sync:templates": "node scripts/sync-templates.mjs",
    "check:agent-paths": "node scripts/check-agent-paths.mjs",
    "check:customer-auth-boundary": "bash scripts/contracts/validate-customer-auth-boundary.sh",
    "check:framework-knowledge-boundary": "bash scripts/contracts/validate-framework-knowledge-boundary.sh",
    "check:host-contract-lab": "bash scripts/contracts/validate-host-contract-lab.sh",
    "check:iam-directory-boundary": "bash scripts/contracts/validate-iam-directory-boundary.sh",
    "check:media-thumbnail64": "node scripts/contracts/validate-media-thumbnail64.mjs",
    "check:business-notification-card": "node scripts/contracts/validate-business-notification-card.mjs",
    "check:ai-media-v2-contract": "node scripts/contracts/validate-ai-media-v2.mjs && node --test scripts/contracts/validate-ai-media-v2.test.mjs",
    "check:realtime-transport": "bash scripts/contracts/validate-realtime-transport.sh",
    "test": "node scripts/capabilities/run-from-package.mjs && npm run check:customer-auth-boundary && npm run check:framework-knowledge-boundary && npm run check:host-contract-lab && npm run check:iam-directory-boundary && npm run check:realtime-transport && npm run check:ai-media-v2-contract && npm run check:business-notification-card && npm run check:media-thumbnail64 && npm run check:ai-connection-test && npm run check:ai-online-model-catalog && npm run check:plugin-authorization && npm run check:event-fabric && npm run check:session-termination",
    "check:ai-connection-test": "node scripts/contracts/validate-ai-connection-test.mjs",
    "check:ai-online-model-catalog": "node scripts/contracts/validate-ai-online-model-catalog.mjs",
    "check:plugin-authorization": "node scripts/contracts/validate-plugin-authorization.mjs",
    "check:event-fabric": "node scripts/contracts/validate-event-fabric.mjs",
    "sync:plugin-id": "node scripts/contracts/sync-plugin-id.mjs",
    "check:plugin-id": "node scripts/contracts/sync-plugin-id.mjs --check && node --test tests/packaging/plugin-id-contract.test.mjs",
    "check:session-termination": "node scripts/contracts/validate-session-termination.mjs"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8",
    "yaml": "^2.8.1"
  }
}
