# Runtime mode
# 0 = standalone, 1 = host/proxy
POWERX_PROXY=0
IAMMode=local
POWERX_RBAC_DELEGATE=false

# HTTP / logging
POWERX_HTTP_ADDR=:{{ .BackendPort }}
POWERX_LOG_LEVEL=info

# Local IAM seed
PLUGIN_IAM_TENANT_KEY=00000000-0000-0000-0000-000000000001
PLUGIN_IAM_TENANT_NAME=Local Tenant
PLUGIN_IAM_ADMIN_EMAIL=admin@local.test
PLUGIN_IAM_ADMIN_PASSWORD='S3cret!!'

# Gateway auth (capability/ws-bus)
PX_GATEWAY_BASE_URL=http://127.0.0.1:8077
# bearer (host) / apikey (standalone+proxy)
PX_GATEWAY_AUTH_SCHEME=bearer
PX_TOOL_TOKEN=replace-me-with-tool-token
PX_GATEWAY_API_KEY=
PX_TOOL_REFRESH_TOKEN=replace-me-with-refresh-token
PX_AUTH_BASE_URL=
PX_GATEWAY_TIMEOUT=15s
PX_GATEWAY_USER_AGENT=powerx-plugin/{{ .PluginID }}
PX_PLUGIN_TOOL_TOKEN=
PX_PLUGIN_API_KEY=
# PX_USE_MOCK=

# Optional host simulation
# POWERX_PROXY=1
# POWERX_RBAC_DELEGATE=true
# POWERX_CORE_ENDPOINT=http://localhost:8090
# POWERX_SECURITY_JWT_ISSUER=powerx-auth
# POWERX_SECURITY_JWT_AUDIENCE=plugin:{{ .PluginID }}
