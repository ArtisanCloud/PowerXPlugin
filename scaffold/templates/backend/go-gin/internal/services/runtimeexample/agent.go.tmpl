func (s *LocalAgent) agent(ctx context.Context, id string) (string, config.LocalAgent, error) {
	t, e := agentScope(ctx)
	if e != nil {
		return "", config.LocalAgent{}, e
	}
	a, ok := s.agents[id]
	if !ok {
		return "", a, agentError(404, "AGENT_NOT_FOUND")
	}
	return t, a, nil
}
func (s *LocalAgent) GetHealthSummary(ctx context.Context, id string) (*dto.HealthSummary, error) {
	t, _, e := s.agent(ctx, id)
	if e != nil {
		return nil, e
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	out := &dto.HealthSummary{Status: "unverified"}
	var succeeded, failed int
	for _, v := range s.sessions {
		if v.tenant != t || v.value.AgentUUID != id {
			continue
		}
		for _, r := range v.runs {
			if r.value.Status == "succeeded" {
				succeeded++
			}
			if r.value.Status == "failed" {
				failed++
			}
			if r.value.FinishedAt != nil && r.value.FinishedAt.Format(time.RFC3339Nano) > out.UpdatedAt {
				out.UpdatedAt = r.value.FinishedAt.Format(time.RFC3339Nano)
			}
		}
	}
	n := succeeded + failed
	if n > 0 {
		out.Status = "observed"
		out.Metrics.SuccessRate = float64(succeeded) / float64(n)
		out.Metrics.ErrorRate = float64(failed) / float64(n)
		out.HealthScore = int32(100 * succeeded / n)
	}
	if s.frozen[t+id] {
		out.Status = "frozen"
	}
	return out, nil
}
func (s *LocalAgent) ListHealthHistory(ctx context.Context, id string, hours, limit int) (*dto.HealthHistory, error) {
	if hours < 0 || hours > 8760 || limit < 0 || limit > 1000 {
		return nil, agentError(400, "INVALID_ARGUMENT")
	}
	t, _, e := s.agent(ctx, id)
	if e != nil {
		return nil, e
	}
	if hours == 0 {
		hours = 24
	}
	if limit == 0 {
		limit = 20
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	cutoff := time.Now().Add(-time.Duration(hours) * time.Hour)
	out := &dto.HealthHistory{Snapshots: []dto.HealthSummary{}}
	for _, v := range s.sessions {
		if v.tenant != t || v.value.AgentUUID != id {
			continue
		}
		for _, r := range v.runs {
			if r.value.FinishedAt == nil || r.value.FinishedAt.Before(cutoff) {
				continue
			}
			h := dto.HealthSummary{Status: r.value.Status, UpdatedAt: r.value.FinishedAt.Format(time.RFC3339Nano)}
			if r.value.Status == "succeeded" {
				h.HealthScore = 100
				h.Metrics.SuccessRate = 1
			} else if r.value.Status == "failed" {
				h.Metrics.ErrorRate = 1
			}
			h.Metrics.P95LatencyMs = int32(r.value.FinishedAt.Sub(r.value.CreatedAt).Milliseconds())
			out.Snapshots = append(out.Snapshots, h)
		}
	}
	sort.Slice(out.Snapshots, func(i, j int) bool { return out.Snapshots[i].UpdatedAt > out.Snapshots[j].UpdatedAt })
	if len(out.Snapshots) > limit {
		out.Snapshots = out.Snapshots[:limit]
	}
	return out, nil
}
func (s *LocalAgent) GetBridgeState(ctx context.Context, id string, limit int) (*json.RawMessage, error) {
	t, a, e := s.agent(ctx, id)
	if e != nil {
		return nil, e
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	raw, e := json.Marshal(map[string]any{"agent_uuid": id, "plugin_id": s.plugin, "model_key": a.ModelKey, "frozen": s.frozen[t+id], "capacity_instances": 1})
	out := json.RawMessage(raw)
	return &out, e
}
func (s *LocalAgent) control(ctx context.Context, id string, freeze bool) (*dto.BridgeLifecycleResult, error) {
	t, a, e := s.agent(ctx, id)
	if e != nil {
		return nil, e
	}
	s.mu.Lock()
	defer s.mu.Unlock()
	s.frozen[t+id] = freeze
	status := "active"
	if freeze {
		status = "frozen"
	}
	return &dto.BridgeLifecycleResult{Agent: dto.BridgeAgent{UUID: id, TenantUUID: t, Alias: a.Name, Status: status}}, nil
}
func (s *LocalAgent) Freeze(ctx context.Context, id string, _ dto.BridgeControlInput) (*dto.BridgeLifecycleResult, error) {
	return s.control(ctx, id, true)
}
func (s *LocalAgent) Recover(ctx context.Context, id string, _ dto.BridgeControlInput) (*dto.BridgeLifecycleResult, error) {
	return s.control(ctx, id, false)
}
func (s *LocalAgent) Rebalance(ctx context.Context, id string, in dto.BridgeRebalanceInput) (*dto.BridgeLifecycleResult, error) {
	if _, _, e := s.agent(ctx, id); e != nil {
		return nil, e
	}
	return nil, agentError(422, "REBALANCE_UNSUPPORTED")
}
