# Runtime mode
# 0 = standalone, 1 = host/proxy
POWERX_PROXY=0
IAM_MODE=local
POWERX_RBAC_DELEGATE=false

# HTTP / API
POWERX_API_PREFIX=/api/v1
PORT={{ .BackendPort }}

# Database (FastAPI 优先读取 POWERX_DB_URL / DATABASE_URL)
POWERX_DB_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg2://user:pass@127.0.0.1:5432/dbname
POWERX_DB_SCHEMA=
POWERX_DB_ECHO=0

# Gateway auth (capability/ws-bus)
PX_GATEWAY_BASE_URL=http://127.0.0.1:8077
PX_GATEWAY_AUTH_SCHEME=bearer
PX_TOOL_TOKEN=replace-me-with-tool-token
PX_GATEWAY_API_KEY=
PX_TOOL_REFRESH_TOKEN=replace-me-with-refresh-token
PX_AUTH_BASE_URL=

# WS bus runtime (可选)
PX_WS_BUS_PROVIDER=memory
# PX_WS_BUS_REDIS_URL=redis://127.0.0.1:6379/0
PX_WS_BUS_CHANNEL=powerx.wsbus
