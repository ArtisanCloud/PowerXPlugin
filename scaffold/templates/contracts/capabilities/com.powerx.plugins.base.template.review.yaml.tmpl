id: {{ .PluginID }}.template.review
type: API
version: 1.0.0
title_i18n:
  zh-CN: 审核模板
  zh: 审核模板
  en: Review Template
description: "审核模板草稿，附带意见与敏感字段校验。"
description_i18n:
  zh-CN: 审核模板草稿，附带意见与敏感字段校验。
  zh: 审核模板草稿，附带意见与敏感字段校验。
  en: Review a template draft with comments and sensitive-field checks.
rbac:
  resource: template
  actions: [update]
provides:
  - id: schema/input/{{ .PluginID }}.template.review.v1
    path: schema/input/{{ .PluginID }}.template.review.json
    kind: input
    version: 1.0.0
  - id: schema/output/{{ .PluginID }}.template.review.v1
    path: schema/output/{{ .PluginID }}.template.review.json
    kind: output
    version: 1.0.0
metadata:
  protocols:
    rest:
      method: POST
      path: /api/v1/integration/capabilities/invoke
      description: "PowerX Gateway 统一鉴权后的插件能力入口"
    agent_tool:
      id: base.template.review
      scope: agent.template.review
      transport: http
      endpoint: /api/v1/integration/capabilities/invoke
