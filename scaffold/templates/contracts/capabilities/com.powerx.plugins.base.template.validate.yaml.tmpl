id: {{ .PluginID }}.template.validate
type: API
version: 1.0.0
title_i18n:
  zh-CN: 校验模板
  zh: 校验模板
  en: Validate Template
description: "对指定模板执行规则校验并返回违规项，支持 Agent 巡检。"
description_i18n:
  zh-CN: 对指定模板执行规则校验并返回违规项，支持 Agent 巡检。
  zh: 对指定模板执行规则校验并返回违规项，支持 Agent 巡检。
  en: Validate a template against rules and return violations for agent audit flows.
rbac:
  resource: template
  actions: [read]
provides:
  - id: schema/input/{{ .PluginID }}.template.validate.v1
    path: schema/input/{{ .PluginID }}.template.validate.json
    kind: input
    version: 1.0.0
  - id: schema/output/{{ .PluginID }}.template.validate.v1
    path: schema/output/{{ .PluginID }}.template.validate.json
    kind: output
    version: 1.0.0
metadata:
  protocols:
    rest:
      method: POST
      path: /api/v1/integration/capabilities/invoke
      description: "PowerX Gateway 统一鉴权后的插件能力入口"
    grpc:
      service: powerx.template.TemplateService
      method: ValidateTemplate
    workflow:
      template: contracts/exposure/workflow/template-quality-distribute.json
    agent_tool:
      id: base.template.validate
      scope: agent.template.validate
      transport: http
      endpoint: /api/v1/integration/capabilities/invoke
