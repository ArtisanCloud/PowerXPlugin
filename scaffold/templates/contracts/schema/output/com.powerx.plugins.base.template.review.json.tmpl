{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TemplateReviewOutput",
  "type": "object",
  "properties": {
    "template_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "approved",
        "rejected",
        "pending"
      ]
    },
    "reviewer": {
      "type": "string"
    }
  },
  "required": [
    "template_uuid",
    "status"
  ],
  "additionalProperties": true
}
