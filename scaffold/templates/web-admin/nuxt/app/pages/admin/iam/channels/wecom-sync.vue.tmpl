<template>
  <div class="wecom-sync-page p-6 space-y-6">
    <div
      v-if="globalLoading"
      class="fixed inset-0 z-[70] flex items-center justify-center bg-slate-950/50 backdrop-blur-[1px]"
    >
      <div class="min-w-[260px] rounded-xl border border-slate-700 bg-slate-900 px-6 py-5 text-slate-100 shadow-xl">
        <div class="flex items-center gap-3">
          <UIcon name="i-lucide-loader-circle" class="h-5 w-5 animate-spin text-cyan-300" />
          <span class="text-sm">{{ `{{ globalLoadingText }}` }}</span>
        </div>
      </div>
    </div>

    <section class="rounded-2xl border border-slate-800 bg-slate-950/70 p-5">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p class="text-xs uppercase tracking-[0.2em] text-cyan-300/80">Channel Sync Center</p>
          <h1 class="mt-1 text-2xl font-semibold text-slate-100">企业微信同步中心</h1>
          <p class="mt-2 text-sm text-slate-400">
            同步任务可追踪、可分页、可筛选。当前版本使用 WS 事件优先（断线回退轮询）；full_sync 会拉取企业微信组织并写入本地 IAM。
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <UBadge :color="configReady ? 'success' : 'warning'" variant="soft">
            {{ `{{ configReady ? "配置已就绪" : "配置未完成" }}` }}
          </UBadge>
          <UButton to="/admin/iam/channels/wecom" variant="soft" color="neutral" size="sm">去基础配置</UButton>
          <UButton variant="outline" size="sm" :loading="tasksLoading" @click="fetchSyncTasks">刷新任务</UButton>
          <UButton
            variant="outline"
            color="error"
            size="sm"
            :disabled="!syncTasks.length || clearLoading"
            :loading="clearLoading"
            @click="clearSyncTasks"
          >
            清空记录
          </UButton>
        </div>
      </div>
    </section>

    <section class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
      <UCard class="stat-card">
        <p class="stat-title">任务总数</p>
        <p class="stat-value">{{ `{{ stats.total }}` }}</p>
      </UCard>
      <UCard class="stat-card">
        <p class="stat-title">运行中</p>
        <p class="stat-value text-amber-400">{{ `{{ stats.running }}` }}</p>
      </UCard>
      <UCard class="stat-card">
        <p class="stat-title">成功</p>
        <p class="stat-value text-emerald-400">{{ `{{ stats.success }}` }}</p>
      </UCard>
      <UCard class="stat-card">
        <p class="stat-title">失败</p>
        <p class="stat-value text-rose-400">{{ `{{ stats.failed }}` }}</p>
      </UCard>
    </section>

    <UCard class="panel-card">
      <template #header>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="text-lg font-semibold text-slate-100">同步执行面板</h3>
          <UBadge color="neutral" variant="soft">{{ `{{ tenantUUID }}` }}</UBadge>
        </div>
      </template>

      <div v-if="!configReady" class="rounded-lg border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-sm text-amber-100">
        <p>当前租户尚未完成企业微信配置，无法触发同步任务。</p>
        <p class="mt-1 text-amber-200/80">{{ `{{ configMessage }}` }}</p>
      </div>

      <div class="mt-4">
        <div class="flex flex-wrap items-center gap-2">
          <UButton
            color="primary"
            :disabled="!configReady || isActionBusy"
            :loading="syncingAction === 'full_sync'"
            @click="runSync('full_sync')"
          >
            拉取同步
          </UButton>
          <UButton
            variant="outline"
            color="error"
            :disabled="!syncTasks.length || clearLoading"
            :loading="clearLoading"
            @click="clearSyncTasks"
          >
            清空任务
          </UButton>
        </div>
      </div>

      <div class="mt-4 rounded-lg border border-slate-700 bg-slate-900/50 p-3">
        <div class="mb-2 flex items-center justify-between text-xs text-slate-300">
          <span>任务进度</span>
          <span>{{ `{{ syncProgressText }}` }}</span>
        </div>
        <div class="sync-progress-track">
          <div
            class="sync-progress-fill"
            :class="{
              'sync-progress-fill--animated': isProgressAnimating,
              'sync-progress-fill--error': activeTask?.status === 'failed',
            }"
            :style="{ width: progressBarWidth }"
          />
        </div>
      </div>

      <div class="mt-4 rounded-lg border border-slate-700 bg-slate-900/60 px-4 py-3 text-sm text-slate-300">
        {{ `{{ lastSyncMessage }}` }}
      </div>
      <div v-if="lastErrorMessage" class="mt-3 rounded-lg border border-rose-500/50 bg-rose-500/10 px-4 py-3 text-sm text-rose-200">
        {{ `{{ lastErrorMessage }}` }}
      </div>
    </UCard>

    <UCard class="panel-card">
      <template #header>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h3 class="text-lg font-semibold text-slate-100">任务结果</h3>
          <div class="flex flex-wrap items-center gap-2">
            <UButton
              size="xs"
              :variant="viewMode === 'table' ? 'solid' : 'outline'"
              color="neutral"
              @click="viewMode = 'table'"
            >
              Table View
            </UButton>
            <UButton
              size="xs"
              :variant="viewMode === 'timeline' ? 'solid' : 'outline'"
              color="neutral"
              @click="viewMode = 'timeline'"
            >
              Timeline View
            </UButton>
            <USelect v-model="statusFilter" :items="statusOptions" class="w-36" />
            <USelect v-model="pageSize" :items="pageSizeOptions" class="w-28" />
          </div>
        </div>
      </template>

      <div v-if="tasksLoading && !syncTasks.length" class="space-y-2">
        <USkeleton class="h-12" />
        <USkeleton class="h-12" />
        <USkeleton class="h-12" />
      </div>

      <template v-else>
        <div v-if="!filteredTasks.length" class="rounded-lg border border-slate-800 bg-slate-900/50 p-5 text-sm text-slate-400">
          暂无匹配记录
        </div>

        <template v-else-if="viewMode === 'table'">
          <UTable :data="pagedTasks" :columns="columns" :meta="{ class: { tr: 'align-middle' } }">
            <template #status-cell="{ row }">
              <UBadge :color="statusColor(row.original.status)" variant="soft">
                {{ `{{ statusLabel(row.original.status) }}` }}
              </UBadge>
            </template>
            <template #action-cell="{ row }">
              <span class="text-slate-100">{{ `{{ actionNameMap[row.original.action] || row.original.action }}` }}</span>
            </template>
            <template #summary-cell="{ row }">
              <span class="text-slate-300">{{ `{{ row.original.summary || "-" }}` }}</span>
            </template>
            <template #created_at-cell="{ row }">
              <span class="text-slate-400">{{ `{{ formatTime(row.original.created_at) }}` }}</span>
            </template>
            <template #error_message-cell="{ row }">
              <span class="text-rose-300">{{ `{{ row.original.error_message || "-" }}` }}</span>
            </template>
          </UTable>
        </template>

        <template v-else>
          <div class="space-y-2">
            <div
              v-for="task in pagedTasks"
              :key="task.id"
              class="rounded-lg border border-slate-800 bg-slate-900/55 px-4 py-3"
            >
              <div class="flex flex-wrap items-center gap-2">
                <UBadge :color="statusColor(task.status)" variant="soft">
                  {{ `{{ statusLabel(task.status) }}` }}
                </UBadge>
                <span class="text-sm font-medium text-slate-100">{{ `{{ actionNameMap[task.action] || task.action }}` }}</span>
                <span class="text-xs text-slate-500">{{ `{{ formatTime(task.created_at) }}` }}</span>
              </div>
              <p class="mt-1 text-sm text-slate-300">{{ `{{ task.summary || "-" }}` }}</p>
              <p v-if="task.error_message" class="mt-1 text-sm text-rose-300">{{ `{{ task.error_message }}` }}</p>
            </div>
          </div>
        </template>

        <div class="mt-4 flex items-center justify-between">
          <p class="text-xs text-slate-500">共 {{ `{{ filteredTasks.length }}` }} 条，当前第 {{ `{{ page }}` }} / {{ `{{ totalPages }}` }} 页</p>
          <UPagination v-model:page="page" :total="filteredTasks.length" :items-per-page="pageSize" show-edges />
        </div>
      </template>
    </UCard>
  </div>
</template>

<script setup lang="ts">
import { computed, onBeforeUnmount, onMounted, ref, watch } from "vue";
import { useToast } from "#imports";
import { storeToRefs } from "pinia";
import { getAuthToken, resolveApiBase } from "~/composables/api/_base";
import { useApiClient } from "~/composables/api/_client";
import { useUserStore } from "~/stores/user";
import { resolveTenantUUIDForRequest } from "~/utils/tenant-context";

definePageMeta({
  title: "企业微信同步中心",
  icon: "i-lucide-refresh-cw",
  order: 13,
});

type SyncTask = {
  id: string;
  action: string;
  status: string;
  stage?: string;
  progress_percent?: number;
  summary?: string;
  error_message?: string;
  created_at?: string;
  updated_at?: string;
  started_at?: string;
  finished_at?: string;
};

type WecomConfigResponse = {
  callbackHost?: string;
  callback_host?: string;
  corpId?: string;
  corp_id?: string;
  agentId?: string | number;
  agent_id?: string | number;
  secret?: string;
};

const toast = useToast();
const { get, post, delete: del } = useApiClient();

const syncingAction = ref("");
const tasksLoading = ref(false);
const clearLoading = ref(false);
const bootLoading = ref(true);
const syncTasks = ref<SyncTask[]>([]);
const lastSyncMessage = ref("尚未触发同步任务");
const lastErrorMessage = ref("");
const statusFilter = ref("all");
const page = ref(1);
const pageSize = ref(10);
const viewMode = ref<"table" | "timeline">("table");
const configReady = ref(false);
const configMessage = ref("请先在基础配置页填写 Host、Corp ID、Agent ID、Secret。");
let taskPollTimer: ReturnType<typeof setInterval> | null = null;
let wsConn: WebSocket | null = null;
let wsReconnectTimer: ReturnType<typeof setTimeout> | null = null;
let wsClosedByClient = false;
const wsConnected = ref(false);

const statusOptions = [
  { label: "全部状态", value: "all" },
  { label: "排队中", value: "queued" },
  { label: "运行中", value: "running" },
  { label: "成功", value: "success" },
  { label: "失败", value: "failed" },
];

const pageSizeOptions = [
  { label: "10 / 页", value: 10 },
  { label: "20 / 页", value: 20 },
  { label: "50 / 页", value: 50 },
];

const columns = [
  { accessorKey: "status", header: "状态" },
  { accessorKey: "action", header: "动作" },
  { accessorKey: "summary", header: "摘要" },
  { accessorKey: "error_message", header: "错误" },
  { accessorKey: "created_at", header: "时间" },
];

const actionNameMap: Record<string, string> = {
  full_sync: "拉取同步",
};

const userStore = useUserStore();
const { currentTenantUuid } = storeToRefs(userStore);

const tenantUUID = computed(() => {
  const fromStore = currentTenantUuid.value?.trim();
  if (fromStore) return fromStore;
  return resolveTenantUUIDForRequest() || "00000000-0000-0000-0000-000000000001";
});

const isActionBusy = computed(() => syncingAction.value !== "");
const globalLoading = computed(() => bootLoading.value || isActionBusy.value);
const globalLoadingText = computed(() => {
  if (bootLoading.value) return "正在加载同步中心...";
  return "正在触发同步任务，请稍候...";
});

const latestTask = computed(() => syncTasks.value[0]);
const activeTask = computed(() => latestTask.value);
const syncProgress = computed(() => {
  const task = activeTask.value;
  if (!task) return 0;
  if (task.status === "success" || task.status === "failed") return 100;
  if (typeof task.progress_percent === "number") {
    return Math.max(0, Math.min(100, task.progress_percent));
  }
  if (task.status === "queued") return 10;
  if (task.status === "running") return 30;
  return 0;
});
const syncProgressText = computed(() => {
  const task = activeTask.value;
  if (!task) return "未开始";
  if (task.status === "success") return "已完成";
  if (task.status === "failed") return "执行失败";
  if (task.status === "queued") return "排队中";
  return "执行中";
});
const isProgressAnimating = computed(() => {
  const status = activeTask.value?.status;
  return status === "running" || status === "queued";
});
const progressBarWidth = computed(() => `${Math.max(0, Math.min(100, syncProgress.value))}%`);

const filteredTasks = computed(() => {
  const byStatus =
    statusFilter.value === "all"
      ? syncTasks.value
      : syncTasks.value.filter((task) => task.status === statusFilter.value);
  return [...byStatus].sort((a, b) => {
    const av = new Date(a.created_at || "").getTime();
    const bv = new Date(b.created_at || "").getTime();
    return bv - av;
  });
});

const totalPages = computed(() => {
  const total = Math.ceil(filteredTasks.value.length / pageSize.value);
  return total > 0 ? total : 1;
});

const pagedTasks = computed(() => {
  const start = (page.value - 1) * pageSize.value;
  return filteredTasks.value.slice(start, start + pageSize.value);
});

const stats = computed(() => {
  const all = syncTasks.value;
  return {
    total: all.length,
    running: all.filter((t) => t.status === "running" || t.status === "queued").length,
    success: all.filter((t) => t.status === "success").length,
    failed: all.filter((t) => t.status === "failed").length,
  };
});

watch([statusFilter, pageSize], () => {
  page.value = 1;
});

watch(
  () => filteredTasks.value.length,
  () => {
    if (page.value > totalPages.value) {
      page.value = totalPages.value;
    }
  }
);

const hasPendingTasks = () => {
  const task = latestTask.value;
  if (!task) return false;
  return task.status === "queued" || task.status === "running";
};

const stopTaskPolling = () => {
  if (taskPollTimer) {
    clearInterval(taskPollTimer);
    taskPollTimer = null;
  }
};

const startTaskPolling = () => {
  if (wsConnected.value) return;
  stopTaskPolling();
  taskPollTimer = setInterval(() => {
    fetchSyncTasks(true);
  }, 2500);
};

const normalizeWsPath = (pathname: string) => {
  const clean = pathname.replace(/\/+$/, "");
  if (!clean || clean === "/") return "/api/ws";
  if (clean.endsWith("/api/v1")) return clean.replace(/\/api\/v1$/, "/api/ws");
  if (clean.endsWith("/api")) return `${clean}/ws`;
  return "/api/ws";
};

const buildWsURL = () => {
  if (typeof window === "undefined") return "";
  const apiBase = resolveApiBase();
  const parsed = new URL(apiBase, window.location.origin);
  const protocol = parsed.protocol === "https:" ? "wss:" : "ws:";
  const wsPath = normalizeWsPath(parsed.pathname || "");
  const url = new URL(`${protocol}//${parsed.host}${wsPath}`);
  const token = getAuthToken();
  if (token) {
    url.searchParams.set("authorization", /^Bearer\s/i.test(token) ? token : `Bearer ${token}`);
  }
  if (tenantUUID.value) {
    url.searchParams.set("tenant_uuid", tenantUUID.value);
  }
  return url.toString();
};

const upsertTaskByWS = (payload: any) => {
  const taskID = String(payload?.task_id || "").trim();
  if (!taskID) return;
  const status = String(payload?.status || "running").trim().toLowerCase();
  const action = String(payload?.action || "full_sync").trim();
  const stage = String(payload?.stage || "").trim();
  const message = String(payload?.message || "").trim();
  const progressPercent = Number(payload?.progress_percent);
  const updatedAt = String(payload?.updated_at || new Date().toISOString());

  const patch: SyncTask = {
    id: taskID,
    action,
    status,
    stage,
    summary: message || (status === "running" ? "任务执行中" : ""),
    progress_percent: Number.isFinite(progressPercent) ? progressPercent : undefined,
    updated_at: updatedAt,
    created_at: updatedAt,
    started_at: updatedAt,
    finished_at: status === "success" || status === "failed" ? updatedAt : undefined,
  };

  const idx = syncTasks.value.findIndex((item) => item.id === taskID);
  if (idx >= 0) {
    const merged = { ...syncTasks.value[idx], ...patch };
    const next = [...syncTasks.value];
    next.splice(idx, 1);
    syncTasks.value = [merged, ...next];
  } else {
    syncTasks.value = [patch, ...syncTasks.value];
  }

  lastSyncMessage.value = `${actionNameMap[action] || action}：${statusLabel(status)}${message ? `（${message}）` : ""}`;
};

const connectWS = () => {
  if (typeof window === "undefined") return;
  if (wsConn && (wsConn.readyState === WebSocket.OPEN || wsConn.readyState === WebSocket.CONNECTING)) return;
  const wsURL = buildWsURL();
  if (!wsURL) return;
  wsClosedByClient = false;
  wsConn = new WebSocket(wsURL);
  wsConn.onopen = () => {
    wsConnected.value = true;
    stopTaskPolling();
    wsConn?.send(
      JSON.stringify({
        type: "subscribe",
        topics: ["wecom.sync.progress"],
      })
    );
  };
  wsConn.onmessage = (event) => {
    let parsed: any = null;
    try {
      parsed = JSON.parse(String(event.data || "{}"));
    } catch {
      return;
    }
    if (String(parsed?.type || "").toLowerCase() !== "event") return;
    if (String(parsed?.topic || "") !== "wecom.sync.progress") return;
    upsertTaskByWS(parsed?.payload || {});
    if (!hasPendingTasks()) {
      stopTaskPolling();
    }
  };
  wsConn.onerror = () => {
    wsConnected.value = false;
  };
  wsConn.onclose = () => {
    wsConn = null;
    wsConnected.value = false;
    if (wsClosedByClient) return;
    if (hasPendingTasks()) startTaskPolling();
    if (wsReconnectTimer) clearTimeout(wsReconnectTimer);
    wsReconnectTimer = setTimeout(() => connectWS(), 1200);
  };
};

const disconnectWS = () => {
  wsClosedByClient = true;
  wsConnected.value = false;
  if (wsReconnectTimer) {
    clearTimeout(wsReconnectTimer);
    wsReconnectTimer = null;
  }
  if (wsConn) {
    wsConn.close();
    wsConn = null;
  }
};

const isConfigValid = (raw?: WecomConfigResponse | null) => {
  if (!raw) return false;
  const callbackHost = String(raw.callback_host ?? raw.callbackHost ?? "").trim();
  const corpID = String(raw.corp_id ?? raw.corpId ?? "").trim();
  const agentID = String(raw.agent_id ?? raw.agentId ?? "").trim();
  const secret = String(raw.secret ?? "").trim();
  return Boolean(callbackHost && corpID && agentID && secret);
};

const fetchConfigReadiness = async () => {
  try {
    const response = await get<any>("/admin/iam/channels/wecom/config");
    const payload = (response?.data || response) as WecomConfigResponse;
    configReady.value = isConfigValid(payload);
    configMessage.value = configReady.value
      ? "企业微信配置已完成，可安全触发同步任务。"
      : "基础配置缺失，请补全 Host、Corp ID、Agent ID、Secret。";
  } catch (err: any) {
    configReady.value = false;
    const statusCode = Number(err?.status || err?.response?.status || 0);
    if (statusCode === 404) {
      configMessage.value = "还没有保存企业微信配置，请先去基础配置页完成保存。";
      return;
    }
    configMessage.value = err?.data?.error?.message || err?.message || "读取配置失败";
  }
};

const fetchSyncTasks = async (silent = false) => {
  if (!silent) tasksLoading.value = true;
  try {
    const response = await get<any>("/admin/iam/channels/wecom/sync-tasks", { params: { limit: 200 } });
    const payload = (response?.data || response) as { items?: SyncTask[]; warning?: string };
    syncTasks.value = payload?.items || [];
    if (payload?.warning) {
      lastErrorMessage.value = payload.warning;
    }
    const latest = syncTasks.value[0];
    if (latest) {
      lastSyncMessage.value = `${actionNameMap[latest.action] || latest.action}：${statusLabel(latest.status)}${
        latest.summary ? `（${latest.summary}）` : ""
      }`;
    }
    if (!hasPendingTasks()) stopTaskPolling();
  } catch (err: any) {
    if (!silent) {
      lastErrorMessage.value = err?.data?.error?.message || err?.message || "请求失败";
      toast.add({
        title: "加载任务失败",
        description: lastErrorMessage.value,
        color: "error",
      });
    }
  } finally {
    if (!silent) tasksLoading.value = false;
  }
};

const runSync = async (action: string) => {
  if (!configReady.value) {
    toast.add({
      title: "无法触发同步",
      description: configMessage.value,
      color: "warning",
    });
    return;
  }
  syncingAction.value = action;
  lastErrorMessage.value = "";
  try {
    const response = await post<any>("/admin/iam/channels/wecom/sync-tasks", { action });
    const task = (response?.data || response) as SyncTask;
    lastSyncMessage.value = `${actionNameMap[action]}任务已触发，任务ID：${task.id}`;
    await fetchSyncTasks(true);
    connectWS();
    if (!wsConnected.value) startTaskPolling();
    toast.add({ title: "任务已触发", description: `${actionNameMap[action]}已进入任务队列`, color: "success" });
  } catch (err: any) {
    lastErrorMessage.value = err?.data?.error?.message || err?.message || "请求失败";
    toast.add({
      title: "任务触发失败",
      description: lastErrorMessage.value,
      color: "error",
    });
  } finally {
    syncingAction.value = "";
  }
};

const clearSyncTasks = async () => {
  if (!syncTasks.value.length) return;
  const confirmed = typeof window === "undefined" ? true : window.confirm("确认清空当前租户的全部同步任务记录？");
  if (!confirmed) return;
  clearLoading.value = true;
  lastErrorMessage.value = "";
  try {
    const response = await del<any>("/admin/iam/channels/wecom/sync-tasks");
    const payload = (response?.data || response) as { deleted?: number };
    const deleted = Number(payload?.deleted || 0);
    syncTasks.value = [];
    page.value = 1;
    lastSyncMessage.value = "尚未触发同步任务";
    stopTaskPolling();
    toast.add({
      title: "已清空任务",
      description: `已删除 ${deleted} 条同步任务记录`,
      color: "success",
    });
  } catch (err: any) {
    lastErrorMessage.value = err?.data?.error?.message || err?.message || "请求失败";
    toast.add({
      title: "清空失败",
      description: lastErrorMessage.value,
      color: "error",
    });
  } finally {
    clearLoading.value = false;
  }
};

const statusColor = (status?: string) => {
  switch (status) {
    case "success":
      return "success";
    case "failed":
      return "error";
    case "running":
      return "warning";
    default:
      return "neutral";
  }
};

const statusLabel = (status?: string) => {
  switch (status) {
    case "queued":
      return "排队中";
    case "running":
      return "运行中";
    case "success":
      return "成功";
    case "failed":
      return "失败";
    default:
      return status || "-";
  }
};

const formatTime = (raw?: string) => {
  if (!raw) return "-";
  const dt = new Date(raw);
  if (Number.isNaN(dt.getTime())) return raw;
  return dt.toLocaleString();
};

onMounted(async () => {
  try {
    await Promise.all([fetchConfigReadiness(), fetchSyncTasks(true)]);
    connectWS();
    if (!wsConnected.value && hasPendingTasks()) startTaskPolling();
  } finally {
    bootLoading.value = false;
  }
});

onBeforeUnmount(() => {
  stopTaskPolling();
  disconnectWS();
});
</script>

