  } finally {
    schedulerResuming.value = false
  }
}

const triggerSelectedSchedulerJob = () => triggerSchedulerJobByID(selectedSchedulerJobID.value)
const pauseSelectedSchedulerJob = () => pauseSchedulerJobByID(selectedSchedulerJobID.value)
