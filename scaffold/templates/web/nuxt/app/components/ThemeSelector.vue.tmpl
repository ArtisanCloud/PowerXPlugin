<template>
  <UDropdownMenu :items="dropdownItems" :popper="{ placement: 'bottom-end' }">
    <UButton
      color="neutral"
      variant="ghost"
      :icon="currentThemeIcon"
      size="sm"
      square
    />
  </UDropdownMenu>
</template>

<script setup lang="ts">
const { theme, themes, setTheme } = useTheme()
const { t } = useI18n()

const themeIcons: Record<string, string> = {
  light: 'i-heroicons-sun',
  dark: 'i-heroicons-moon',
}

const currentThemeIcon = computed(() => themeIcons[theme.value] || 'i-heroicons-sun')

const dropdownItems = computed(() => [
  themes.map((themeOption) => ({
    label: t(`theme.${themeOption.value}`),
    icon: themeIcons[themeOption.value] || 'i-heroicons-sun',
    onSelect: () => setTheme(themeOption.value),
  })),
])
</script>
