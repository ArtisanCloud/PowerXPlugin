{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PowerXPlugin RBAC Report",
  "type": "object",
  "required": ["pluginId", "roles"],
  "properties": {
    "pluginId": {
      "type": "string",
      "pattern": "^[a-z0-9\\.\\-]+$"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "permissions"],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9\\.\\-]+\\.[a-z0-9\\.\\-]+\\.[a-z0-9\\.\\-]+$",
              "description": "必须引用 Manifest.permissions 中的键。"
            }
          }
        }
      }
    },
    "defaultAssignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["hostRole", "pluginRole"],
        "properties": {
          "hostRole": {
            "type": "string"
          },
          "pluginRole": {
            "type": "string"
          }
        }
      },
      "description": "可选：定义宿主平台默认角色映射。"
    }
  }
}
