{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PowerX Plugin Manifest",
  "type": "object",
  "required": ["id", "name"],
  "$defs": {
    "menu": {
      "type": "object",
      "required": ["path", "title"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/_p/[a-z0-9.-]+/admin(/.*)?$"
        },
        "title": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/menu"
          }
        }
      },
      "additionalProperties": false
    },
    "localeText": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]{2}(-[A-Z]{2})?$": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "permissionCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+:[a-z][a-z0-9_]*$"
    },
    "roleCode": {
      "type": "string",
      "enum": ["role_owner", "role_admin", "role_user", "role_readonly", "role_vendor"]
    },
    "permissionProtocolBinding": {
      "type": "object",
      "required": ["channel", "method", "path", "actor_context", "resource_scope"],
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["rest"]
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "actor_context": {
          "type": "string",
          "enum": ["admin_user", "service_actor", "web_user", "mini_app_user", "customer_actor"]
        },
        "resource_scope": {
          "type": "string",
          "enum": ["tenant", "owner", "self", "department", "global"]
        }
      },
      "additionalProperties": false
    },
    "permissionDeclaration": {
      "type": "object",
      "required": ["type", "permission_code", "title_i18n", "description_i18n", "risk_level"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["menu", "page", "action", "api"]
        },
        "permission_code": {
          "$ref": "#/$defs/permissionCode"
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "title_i18n": {
          "$ref": "#/$defs/localeText"
        },
        "description_i18n": {
          "$ref": "#/$defs/localeText"
        },
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "data_scope": {
          "type": "string",
          "enum": ["tenant", "owner", "self", "factory", "department", "global"]
        },
        "default_role_grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/roleCode"
          },
          "uniqueItems": true
        },
        "business_permission_code": {
          "$ref": "#/$defs/permissionCode"
        },
        "independent": {
          "type": "boolean"
        },
        "protocol_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/permissionProtocolBinding"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "page" } },
            "required": ["type"]
          },
          "then": {
            "required": ["protocol_bindings"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "api" } },
            "required": ["type"]
          },
          "then": {
            "required": ["protocol_bindings"],
            "anyOf": [
              { "required": ["business_permission_code"] },
              {
                "properties": { "independent": { "const": true } },
                "required": ["independent"]
              }
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$",
      "description": "插件唯一 ID，例如 com.powerx.sample"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "menus": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/menu"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z0-9.-]+\\.[a-z0-9.-]+\\.[a-z0-9.-]+$"
          },
          {
            "$ref": "#/$defs/permissionDeclaration"
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
