{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:powerx:plugin-publisher:v1",
  "title": "PowerX Plugin Publisher v1 P01 contract",
  "description": "Versioned wire shapes and conformance definitions; no running HTTP service is implied. UTF-8 byte and cross-field constraints are also mandatory.",
  "$defs": {
    "UUID": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "OperationID": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "PluginID": {
      "title": "PowerX Plugin ID v1",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*$",
      "not": {
        "pattern": "^com\\.powerx\\.plugin(?:\\.|$)|^com\\.powerx\\.plugins$|[^a-z0-9.-]"
      },
      "$comment": "PowerX-owned IDs use com.powerx.plugins.<name>. Third-party namespaces and single-segment IDs remain supported. No additional total-length limit. Reject legacy IDs without rewriting."
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "UTC": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "Version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 50,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "StableVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 50,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "Channel": {
      "const": "stable"
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "enum": [
            "linux",
            "darwin",
            "windows"
          ]
        },
        "arch": {
          "enum": [
            "amd64",
            "arm64"
          ]
        }
      },
      "required": [
        "os",
        "arch"
      ]
    },
    "UploadTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "const": "linux"
        },
        "arch": {
          "const": "amd64"
        }
      },
      "required": [
        "os",
        "arch"
      ]
    },
    "Scope": {
      "enum": [
        "plugins:read",
        "packages:write",
        "publications:read",
        "publications:submit"
      ]
    },
    "Scopes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Scope"
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "PluginIDs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PluginID"
      },
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true
    },
    "WebURL": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "format": "uri",
      "pattern": "^https?://"
    },
    "NullableUTC": {
      "anyOf": [
        {
          "$ref": "#/$defs/UTC"
        },
        {
          "type": "null"
        }
      ]
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/UUID"
        },
        "os": {
          "enum": [
            "linux",
            "darwin",
            "windows"
          ]
        },
        "arch": {
          "enum": [
            "amd64",
            "arm64"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        }
      },
      "required": [
        "artifact_id",
        "os",
        "arch",
        "sha256",
        "size"
      ]
    },
    "Artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "minItems": 0,
      "maxItems": 6
    },
    "PublicationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10000
        },
        "license": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{1,99}$"
        },
        "min_core": {
          "$ref": "#/$defs/Version",
          "maxLength": 20,
          "type": "string"
        },
        "support_url": {
          "$ref": "#/$defs/WebURL"
        },
        "icon_url": {
          "anyOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/$defs/WebURL"
            }
          ]
        },
        "security_statement": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10000
        },
        "privacy_statement": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10000
        }
      },
      "required": [
        "description",
        "license",
        "min_core",
        "support_url",
        "security_statement",
        "privacy_statement"
      ]
    },
    "UploadFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "#/$defs/StableVersion"
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "os": {
          "const": "linux"
        },
        "arch": {
          "const": "amd64"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "release_notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000
        }
      },
      "required": [
        "version",
        "channel",
        "os",
        "arch",
        "sha256",
        "size",
        "release_notes"
      ]
    },
    "UploadRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "format": "binary"
        },
        "version": {
          "$ref": "#/$defs/StableVersion"
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "os": {
          "const": "linux"
        },
        "arch": {
          "const": "amd64"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "release_notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000
        }
      },
      "required": [
        "file",
        "version",
        "channel",
        "os",
        "arch",
        "sha256",
        "size",
        "release_notes"
      ]
    },
    "UploadFingerprintInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "$ref": "#/$defs/PluginID"
        },
        "version": {
          "$ref": "#/$defs/StableVersion"
        },
        "channel": {
          "$ref": "#/$defs/Channel"
        },
        "os": {
          "const": "linux"
        },
        "arch": {
          "const": "amd64"
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "release_notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000
        }
      },
      "required": [
        "plugin_id",
        "version",
        "channel",
        "os",
        "arch",
        "sha256",
        "size",
        "release_notes"
      ]
    },
    "SubmitRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "$ref": "#/$defs/PublicationMetadata"
        },
        "expected_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "minItems": 1,
          "maxItems": 6
        }
      },
      "required": [
        "metadata",
        "expected_artifacts"
      ]
    },
    "SubmitFingerprintInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "$ref": "#/$defs/PluginID"
        },
        "version_id": {
          "$ref": "#/$defs/UUID"
        },
        "metadata": {
          "$ref": "#/$defs/PublicationMetadata"
        },
        "expected_artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "minItems": 1,
          "maxItems": 6
        }
      },
      "required": [
        "plugin_id",
        "version_id",
        "metadata",
        "expected_artifacts"
      ]
    },
    "Plugin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugin_id": {
          "$ref": "#/$defs/PluginID"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "visibility": {
          "enum": [
            "draft",
            "published"
          ]
        }
      },
      "required": [
        "plugin_id",
        "name",
        "summary",
        "visibility"
      ]
    },
    "MarketVersion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version_id": {
          "$ref": "#/$defs/UUID"
        },
        "plugin_id": {
          "$ref": "#/$defs/PluginID"
        },
        "version": {
          "$ref": "#/$defs/Version"
        },
        "channel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "availability_status": {
          "enum": [
            "draft",
            "submitted",
            "rejected",
            "approved",
            "published",
            "deleting"
          ]
        },
        "release_notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000
        },
        "min_core": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20
        },
        "created_at": {
          "$ref": "#/$defs/UTC"
        },
        "published_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UTC"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifacts": {
          "$ref": "#/$defs/Artifacts"
        },
        "market_version_url": {
          "$ref": "#/$defs/WebURL"
        }
      },
      "required": [
        "version_id",
        "plugin_id",
        "version",
        "channel",
        "availability_status",
        "release_notes",
        "min_core",
        "created_at",
        "published_at",
        "artifacts",
        "market_version_url"
      ]
    },
    "UploadReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/OperationID"
        },
        "plugin_id": {
          "$ref": "#/$defs/PluginID"
        },
        "version_id": {
          "$ref": "#/$defs/UUID"
        },
        "version": {
          "$ref": "#/$defs/StableVersion"
        },
        "artifact": {
          "$ref": "#/$defs/Artifact"
        },
        "market_version_url": {
          "$ref": "#/$defs/WebURL"
        }
      },
      "required": [
        "operation_id",
        "plugin_id",
        "version_id",
        "version",
        "artifact",
        "market_version_url"
      ]
    },
    "SubmissionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/OperationID"
        },
        "publication_id": {
          "$ref": "#/$defs/UUID"
        },
        "version_id": {
          "$ref": "#/$defs/UUID"
        },
        "status": {
          "const": "submitted"
        },
        "submitted_at": {
          "$ref": "#/$defs/UTC"
        },
        "market_publication_url": {
          "$ref": "#/$defs/WebURL"
        }
      },
      "required": [
        "operation_id",
        "publication_id",
        "version_id",
        "status",
        "submitted_at",
        "market_publication_url"
      ]
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            400,
            401,
            403,
            404,
            408,
            409,
            413,
            415,
            429,
            500,
            503
          ]
        },
        "error": {
          "enum": [
            "invalid_input",
            "package_plugin_id_mismatch",
            "package_version_mismatch",
            "package_target_mismatch",
            "package_digest_mismatch",
            "package_invalid",
            "publisher_scope_unsupported",
            "publisher_unauthorized",
            "publisher_forbidden",
            "not_found",
            "request_timeout",
            "artifact_conflict",
            "version_locked",
            "idempotency_conflict",
            "artifact_set_changed",
            "artifact_changed",
            "publication_state",
            "license_blocked",
            "security_blocked",
            "channel_mismatch",
            "version_not_newer",
            "feature_unavailable",
            "publisher_token_limit",
            "package_too_large",
            "package_budget_exceeded",
            "unsupported_media_type",
            "rate_limited",
            "internal_error",
            "storage_unavailable",
            "publication_options_unavailable",
            "publisher_unavailable",
            "request_too_large"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "retryable": {
          "type": "boolean"
        },
        "field_errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100,
                "pattern": "^[a-zA-Z0-9_.\\[\\]-]+$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            },
            "required": [
              "field",
              "reason"
            ]
          },
          "minItems": 0,
          "maxItems": 20
        },
        "operation_id": {
          "$ref": "#/$defs/OperationID"
        }
      },
      "required": [
        "code",
        "error",
        "message",
        "retryable"
      ]
    },
    "OperationProcessing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/OperationID"
        },
        "type": {
          "enum": [
            "package-upload",
            "publication-submit"
          ]
        },
        "plugin_id": {
          "$ref": "#/$defs/PluginID"
        },
        "request_sha256": {
          "$ref": "#/$defs/Digest"
        },
        "created_at": {
          "$ref": "#/$defs/UTC"
        },
        "updated_at": {
          "$ref": "#/$defs/UTC"
        },
        "status": {
          "const": "processing"
        },
        "retain_until": {
          "type": "null"
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "required": [
        "operation_id",
        "type",
        "plugin_id",
        "request_sha256",
        "created_at",
        "updated_at",
        "status",
        "retain_until",
        "retry_after_seconds"
      ]
    },
    "OperationSucceeded": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/OperationID"
        },
        "type": {
          "enum": [
            "package-upload",
            "publication-submit"
          ]
        },
        "plugin_id": {
          "$ref": "#/$defs/PluginID"
        },
        "request_sha256": {
          "$ref": "#/$defs/Digest"
        },
        "created_at": {
          "$ref": "#/$defs/UTC"
        },
        "updated_at": {
          "$ref": "#/$defs/UTC"
        },
        "status": {
          "const": "succeeded"
        },
        "retain_until": {
          "$ref": "#/$defs/UTC"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/UploadReceipt"
            },
            {
              "$ref": "#/$defs/SubmissionReceipt"
            }
          ]
        }
      },
      "required": [
        "operation_id",
        "type",
        "plugin_id",
        "request_sha256",
        "created_at",
        "updated_at",
        "status",
        "retain_until",
        "result"
      ]
    },
    "OperationFailed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/OperationID"
        },
        "type": {
          "enum": [
            "package-upload",
            "publication-submit"
          ]
        },
        "plugin_id": {
          "$ref": "#/$defs/PluginID"
        },
        "request_sha256": {
          "$ref": "#/$defs/Digest"
        },
        "created_at": {
          "$ref": "#/$defs/UTC"
        },
        "updated_at": {
          "$ref": "#/$defs/UTC"
        },
        "status": {
          "const": "failed"
        },
        "retain_until": {
          "$ref": "#/$defs/UTC"
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "operation_id",
        "type",
        "plugin_id",
        "request_sha256",
        "created_at",
        "updated_at",
        "status",
        "retain_until",
        "error"
      ]
    },
    "Operation": {
      "oneOf": [
        {
          "$ref": "#/$defs/OperationProcessing"
        },
        {
          "$ref": "#/$defs/OperationSucceeded"
        },
        {
          "$ref": "#/$defs/OperationFailed"
        }
      ]
    },
    "CreateTokenRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "plugin_ids": {
          "$ref": "#/$defs/PluginIDs"
        },
        "scopes": {
          "$ref": "#/$defs/Scopes"
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 2592000
        }
      },
      "required": [
        "name",
        "plugin_ids",
        "scopes"
      ]
    },
    "PublishToken": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token_id": {
          "$ref": "#/$defs/UUID"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "plugin_ids": {
          "$ref": "#/$defs/PluginIDs"
        },
        "scopes": {
          "$ref": "#/$defs/Scopes"
        },
        "created_at": {
          "$ref": "#/$defs/UTC"
        },
        "expires_at": {
          "$ref": "#/$defs/UTC"
        },
        "last_used_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UTC"
            },
            {
              "type": "null"
            }
          ]
        },
        "revoked_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UTC"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "active",
            "expired",
            "revoked"
          ]
        }
      },
      "required": [
        "token_id",
        "name",
        "plugin_ids",
        "scopes",
        "created_at",
        "expires_at",
        "last_used_at",
        "revoked_at",
        "status"
      ]
    },
    "CreatedToken": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^pxpub_[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
        },
        "credential": {
          "$ref": "#/$defs/PublishToken"
        }
      },
      "required": [
        "token",
        "credential"
      ]
    },
    "RevokeTokenRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1000
        }
      },
      "required": [
        "reason"
      ]
    },
    "Me": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "user_id": {
              "$ref": "#/$defs/UUID"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "required": [
            "user_id",
            "name"
          ]
        },
        "developer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "developer_id": {
              "$ref": "#/$defs/UUID"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
