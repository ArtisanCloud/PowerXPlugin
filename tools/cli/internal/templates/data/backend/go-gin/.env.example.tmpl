POWERX_PROXY=0
IAMMode=local
POWERX_RBAC_DELEGATE=false

# 服务与网关
PX_GATEWAY_BASE_URL=http://127.0.0.1:8077
# 默认 /api/v1；若你的底座网关是 /api，可改为 /api
PX_GATEWAY_API_PREFIX=/api/v1
# 宿主委派推荐 bearer；Standalone/Standalone+Proxy 按环境选择 bearer 或 apikey
PX_GATEWAY_AUTH_SCHEME=apikey
PX_TOOL_TOKEN=replace-me-with-tool-token
PX_GATEWAY_API_KEY=
PX_TOOL_REFRESH_TOKEN=replace-me-with-refresh-token
