type notConfiguredTaskBusProvider struct {
	reason string
}

func (p notConfiguredTaskBusProvider) NewEmitter() (fweventbridge.Emitter, error) {
	reason := strings.TrimSpace(p.reason)
	if reason == "" {
		reason = "taskbus provider is not configured"
	}
	return nil, errors.New(reason)
}

type taskBusRuntime struct {
	Provider      fweventbridge.TaskBusProvider
	StartConsumer func(ctx context.Context)
}

var errHostEventTopicsRequired = errors.New("EVENT_FABRIC_HOST_TOPICS_REQUIRED")

func resolveTaskBusRuntime(cfg *config.Config, mode fwprovider.RuntimeMode, wsHub fwwsbus.LocalHub, log *pxlog.Entry, pxc *client.PowerXServiceClient, descriptors []frameworkrealtime.Descriptor) taskBusRuntime {
	switch mode.TaskBusProvider() {
	case "host":
		return taskBusRuntime{
			Provider: newHostTaskBusProvider(cfg, mode, pxc),
		}
	case "redis":
		return taskBusRuntime{
			Provider: newRedisTaskBusProvider(cfg),
			StartConsumer: func() func(context.Context) {
				if cfg == nil || cfg.EventBridge == nil || !cfg.EventBridge.Enabled {
					return nil
				}
				return newRedisConsumerStarter(cfg, wsHub, log, descriptors)
			}(),
		}
	default:
		if log != nil {
			log.WithField("provider_mode", mode).Warn("unknown taskbus provider mode")
		}
		return taskBusRuntime{
			Provider: notConfiguredTaskBusProvider{reason: "unknown taskbus provider mode"},
		}
	}
}

func newEventBridgeEmitter(cfg *config.Config, mode fwprovider.RuntimeMode, selected taskBusRuntime) (fweventbridge.Emitter, *fweventfabric.Runtime, error) {
	eventCfg := &config.EventBridgeConfig{}
	if cfg != nil && cfg.EventBridge != nil {
		eventCfg = cfg.EventBridge
	}
	factory, err := fweventbridge.NewFactory(fweventbridge.Config{Enabled: eventCfg.Enabled, RuntimeMode: mode, LocalQueueSize: eventCfg.LocalQueueSize})
	if err != nil {
		return nil, nil, err
	}
	factory.WithMetrics(bridgeRecorder{})
	var reliable *fweventfabric.Runtime
	factory.WithTaskBusProvider(func() (fweventbridge.Emitter, error) {
		if mode.TaskBusProvider() == "host" && len(eventCfg.TopicBindings) == 0 && len(eventCfg.PublishTopicKeys) == 0 && len(eventCfg.ConsumeTopicKeys) == 0 {
			return nil, errHostEventTopicsRequired
		}
		if selected.Provider == nil {
			return nil, fweventbridge.ErrTaskBusRequired
		}
		emitter, err := selected.Provider.NewEmitter()
		if err != nil {
			return nil, err
		}
		if mode.TaskBusProvider() == "host" {
			var ok bool
			reliable, ok = emitter.(*fweventfabric.Runtime)
			if !ok {
				return nil, fweventbridge.ErrReliableHostRequired
			}
		}
		return emitter, nil
	})
	emitter, err := factory.NewEmitter()
	if err != nil && reliable != nil {
		_ = reliable.Close()
		reliable = nil
	}
	return emitter, reliable, err
}

func newHostTaskBusProvider(cfg *config.Config, mode fwprovider.RuntimeMode, pxc *client.PowerXServiceClient) fweventbridge.TaskBusProvider {
	gateway := &config.GatewayConfig{}
	eventCfg := &config.EventBridgeConfig{}
	if cfg != nil {
		if cfg.Gateway != nil {
			gateway = cfg.Gateway
		}
		if cfg.EventBridge != nil {
			eventCfg = cfg.EventBridge
		}
	}
	hostCfg := fwtaskbus.HostProviderConfig{
		BaseURL:          strings.TrimSpace(gateway.BaseURL),
		TopicBindings:    eventCfg.TopicBindings,
		PublishTopicKeys: append([]string(nil), eventCfg.PublishTopicKeys...),
		ConsumeTopicKeys: append([]string(nil), eventCfg.ConsumeTopicKeys...),
		APIPrefix:        strings.TrimSpace(gateway.APIPrefix),
		AuthScheme:       strings.ToLower(strings.TrimSpace(gateway.AuthScheme)),
		APIKey:           strings.TrimSpace(gateway.APIKey),
		UserAgent:        strings.TrimSpace(gateway.UserAgent),
		Timeout:          gateway.Timeout,
		SourcePlugin:     strings.TrimSpace(eventCfg.SourcePlugin),
		PayloadVersion:   strings.TrimSpace(eventCfg.PayloadVersion),
	}
	if cfg != nil && cfg.GRPCUpstream != nil {
		hostCfg.TenantUUID = cfg.GRPCUpstream.TenantUUID
	}
	if eventCfg.TenantUUID != "" {
		if hostCfg.TenantUUID != "" && hostCfg.TenantUUID != eventCfg.TenantUUID {
			return notConfiguredTaskBusProvider{reason: "EVENT_FABRIC_TENANT_CONFIG_CONFLICT"}
		}
		hostCfg.TenantUUID = eventCfg.TenantUUID
	}
	switch hostCfg.AuthScheme {
	case "api_key", "api-key":
		hostCfg.AuthScheme = "apikey"
	}
	if hostCfg.TenantUUID == "" && hostCfg.AuthScheme == "apikey" {
		hostCfg.ResolveTenant = func(ctx context.Context) (string, error) {
			reader, err := iamdelegated.NewCoreClientWithAPIKey(iamdelegated.CoreClientConfig{PluginID: hostCfg.SourcePlugin, BaseURL: hostCfg.BaseURL, APIPrefix: hostCfg.APIPrefix, Timeout: hostCfg.Timeout}, hostCfg.APIKey)
			if err != nil {
				return "", err
			}
			tenant, err := reader.GetTenant(ctx, "")
			if err != nil {
				return "", err
			}
			return tenant.TenantUUID, nil
		}
	}
	if hostCfg.AuthScheme != "apikey" && mode.ProviderMode == fwprovider.ModeDelegated {
		hostCfg.TokenProvider = client.NewPowerXSTSTokenProvider(pxc).TokenFunc()
	}
	return fwtaskbus.NewHostProvider(hostCfg)
}

func newRedisTaskBusProvider(cfg *config.Config) fweventbridge.TaskBusProvider {
	eventCfg := &config.EventBridgeConfig{}
	if cfg != nil && cfg.EventBridge != nil {
		eventCfg = cfg.EventBridge
	}
	return fwtaskbus.NewRedisProvider(fwtaskbus.RedisProviderConfig{
		RedisURL:       strings.TrimSpace(eventCfg.RedisURL),
		StreamKey:      strings.TrimSpace(eventCfg.RedisStream),
		SourcePlugin:   strings.TrimSpace(eventCfg.SourcePlugin),
		PayloadVersion: strings.TrimSpace(eventCfg.PayloadVersion),
		MaxLenApprox:   eventCfg.RedisMaxLen,
	})
}

func newRedisConsumerStarter(cfg *config.Config, wsHub fwwsbus.LocalHub, log *pxlog.Entry, descriptors []frameworkrealtime.Descriptor) func(ctx context.Context) {
	if cfg == nil || cfg.EventBridge == nil || wsHub == nil {
		return nil
	}
	eventCfg := cfg.EventBridge
	return func(ctx context.Context) {
		consumer, err := fwtaskbus.NewRedisConsumer(fwtaskbus.RedisConsumerConfig{
			RedisURL:    strings.TrimSpace(eventCfg.RedisURL),
			StreamKey:   strings.TrimSpace(eventCfg.RedisStream),
			Group:       strings.TrimSpace(eventCfg.RedisGroup),
			Consumer:    strings.TrimSpace(eventCfg.RedisConsumer),
			Block:       2 * time.Second,
			BatchSize:   16,
			StartID:     "$",
			DeleteOnAck: true,
		})
		if err != nil {
			if log != nil {
				log.WithError(err).Warn("taskbus redis consumer start failed")
			}
			return
		}
		publisher := frameworkrealtime.NewAuthorizedWSPublisher(fwwsbus.NewLocalPublisher(wsHub, nil), descriptors, "message")
		err = consumer.Consume(ctx, func(handlerCtx context.Context, ev event.Event) error {
			payload, payloadErr := decodeEventPayload(ev.Payload)
			if payloadErr != nil {
				return payloadErr
			}
			result := publisher.Publish(handlerCtx, string(ev.Topic), payload, fwwsbus.PublishOptions{
				TenantUUID: ev.Meta.TenantUUID,
				TraceID:    ev.Meta.TraceID,
			})
			if !result.OK {
				return errors.New(result.ErrorCode + ": " + result.ErrorMessage)
			}
			return nil
		})
		if err != nil && log != nil && !errors.Is(err, context.Canceled) {
			log.WithError(err).Warn("taskbus redis consumer stopped")
		}
	}
}

func decodeEventPayload(raw json.RawMessage) (any, error) {
	if len(raw) == 0 {
		return map[string]any{}, nil
	}
	var payload any
	if err := json.Unmarshal(raw, &payload); err != nil {
		return nil, err
	}
	if payload == nil {
		return map[string]any{}, nil
	}
	return payload, nil
}
