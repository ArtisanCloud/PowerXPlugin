package manifestx

import "github.com/powerx-plugin/framework/backend/go/manifest"

// Plugin 返回插件的默认 Manifest 定义。
func Plugin() manifest.Plugin {
	return manifest.Plugin{
		ID:      "{{ .PluginID }}",
		Name:    "{{ .PluginName }}",
		Version: "{{ .Version }}",
		Menus: []manifest.Menu{
			{
				Path:  "/_p/{{ .PluginID }}/admin",
				Title: "{{ .PluginName }}",
				Children: []manifest.Menu{
					{Path: "/_p/{{ .PluginID }}/admin/intro", Title: "概览"},
					{Path: "/_p/{{ .PluginID }}/admin/templates", Title: "模板管理"},
				},
			},
		},
		Permissions: []string{
			"{{ .PluginID }}.templates.read",
			"{{ .PluginID }}.templates.write",
		},
	}
}
