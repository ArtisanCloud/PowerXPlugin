	"context"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"strings"
	"sync"

	powerxcapability "github.com/ArtisanCloud/PowerXPlugin/framework/backend/go/runtime/powerx/capability"
	"{{ .BackendModulePath }}/internal/capabilities"
	"{{ .BackendModulePath }}/internal/config"
	"{{ .BackendModulePath }}/internal/integrations/gateway"
	"{{ .BackendModulePath }}/internal/logger"
	"{{ .BackendModulePath }}/internal/shared/app"
