package agent

import (
	"net/http"
	"strings"

	frameworkrealtime "github.com/ArtisanCloud/PowerXPlugin/framework/backend/go/runtime/realtime"
	"github.com/gin-gonic/gin"
	"{{ .BackendModulePath }}/internal/contracts"
	"{{ .BackendModulePath }}/internal/integrations/gateway"
	authx "{{ .BackendModulePath }}/internal/middleware"
	"{{ .BackendModulePath }}/internal/shared/app"
)

type Handler struct {
	deps *app.Deps
}

func RegisterAPIRoutes(rg *gin.RouterGroup, deps *app.Deps) {
	h := &Handler{deps: deps}
	group := rg.Group("/plugin/agent")
	group.GET("/agents", h.ListAgents)
	group.POST("/sessions", h.CreateSession)
	group.GET("/sessions", h.ListSessions)
	group.GET("/sessions/:sessionID/messages", h.ListSessionMessages)
	group.POST("/sessions/:sessionID/archive", h.ArchiveSession)
	group.DELETE("/sessions/:sessionID", h.DeleteSession)
	group.GET("/stream/sse", h.StreamSSE)
}

type createSessionRequest struct {
	AgentID   string         `json:"agent_id"`
	AgentUUID string         `json:"agent_uuid"`
	Title     string         `json:"title"`
	Env       string         `json:"env"`
	Meta      map[string]any `json:"meta"`
}

func (h *Handler) ListAgents(c *gin.Context) {
	if h == nil || h.deps == nil || h.deps.CapabilityGateway == nil || !h.deps.CapabilityGateway.Enabled() {
		contracts.ResponseError(c, http.StatusServiceUnavailable, "POWERX_AGENT_GATEWAY_UNAVAILABLE", "PowerX gateway client is not configured")
		return
	}

	env := strings.TrimSpace(c.Query("env"))
	agents, err := h.deps.CapabilityGateway.ListAgents(c.Request.Context(), env)
	if err != nil {
		contracts.ResponseError(c, http.StatusBadGateway, "POWERX_AGENT_LIST_FAILED", err.Error())
		return
	}
	contracts.ResponseSuccess(c, gin.H{"items": agents})
}

func (h *Handler) CreateSession(c *gin.Context) {
	if h == nil || h.deps == nil || h.deps.CapabilityGateway == nil || !h.deps.CapabilityGateway.Enabled() {
		contracts.ResponseError(c, http.StatusServiceUnavailable, "POWERX_AGENT_GATEWAY_UNAVAILABLE", "PowerX gateway client is not configured")
		return
	}

	var req createSessionRequest
	if err := c.ShouldBindJSON(&req); err != nil {
		contracts.ResponseError(c, http.StatusBadRequest, "POWERX_AGENT_SESSION_INVALID_REQUEST", err.Error())
		return
	}
	agentUUID := strings.TrimSpace(req.AgentUUID)
	agentID := strings.TrimSpace(req.AgentID)
	if agentUUID == "" && agentID == "" {
		contracts.ResponseError(c, http.StatusBadRequest, "POWERX_AGENT_SESSION_AGENT_REQUIRED", "agent_uuid or agent_id is required")
		return
	}

	session, err := h.deps.CapabilityGateway.CreateAgentSession(c.Request.Context(), gateway.AgentSessionParams{
		AgentID:    agentID,
		AgentUUID:  agentUUID,
		Title:      strings.TrimSpace(req.Title),
		Env:        strings.TrimSpace(req.Env),
		Meta:       req.Meta,
		TenantUUID: h.tenantUUID(c),
	})
	if err != nil {
		contracts.ResponseError(c, http.StatusBadGateway, "POWERX_AGENT_SESSION_CREATE_FAILED", err.Error())
		return
	}
	contracts.ResponseSuccess(c, session)
}

func (h *Handler) ListSessions(c *gin.Context) {
	if h == nil || h.deps == nil || h.deps.CapabilityGateway == nil || !h.deps.CapabilityGateway.Enabled() {
		contracts.ResponseError(c, http.StatusServiceUnavailable, "POWERX_AGENT_GATEWAY_UNAVAILABLE", "PowerX gateway client is not configured")
		return
	}
	agentID := firstNonEmpty(c.Query("agent_uuid"), c.Query("agent_id"))
	if agentID == "" {
		contracts.ResponseError(c, http.StatusBadRequest, "POWERX_AGENT_SESSION_AGENT_REQUIRED", "agent_uuid or agent_id is required")
		return
	}
	sessions, err := h.deps.CapabilityGateway.ListAgentSessions(c.Request.Context(), gateway.AgentSessionListOptions{
		AgentID:    agentID,
		Env:        strings.TrimSpace(c.Query("env")),
		Status:     strings.TrimSpace(c.Query("status")),
		Limit:      parsePositiveInt(c.Query("limit"), 50),
		TenantUUID: h.tenantUUID(c),
	})
	if err != nil {
		contracts.ResponseError(c, http.StatusBadGateway, "POWERX_AGENT_SESSION_LIST_FAILED", err.Error())
		return
	}
	contracts.ResponseSuccess(c, gin.H{"items": sessions})
}

func (h *Handler) ListSessionMessages(c *gin.Context) {
	if h == nil || h.deps == nil || h.deps.CapabilityGateway == nil || !h.deps.CapabilityGateway.Enabled() {
		contracts.ResponseError(c, http.StatusServiceUnavailable, "POWERX_AGENT_GATEWAY_UNAVAILABLE", "PowerX gateway client is not configured")
		return
	}
	sessionID := strings.TrimSpace(c.Param("sessionID"))
	if sessionID == "" {
		contracts.ResponseError(c, http.StatusBadRequest, "POWERX_AGENT_SESSION_REQUIRED", "session_id is required")
		return
	}
	messages, err := h.deps.CapabilityGateway.ListAgentSessionMessages(c.Request.Context(), gateway.AgentSessionMessageListOptions{
		SessionID:  sessionID,
		Env:        strings.TrimSpace(c.Query("env")),
		AfterID:    strings.TrimSpace(c.Query("after_id")),
		Limit:      parsePositiveInt(c.Query("limit"), 200),
		TenantUUID: h.tenantUUID(c),
	})
	if err != nil {
		contracts.ResponseError(c, http.StatusBadGateway, "POWERX_AGENT_SESSION_MESSAGES_FAILED", err.Error())
		return
	}
	contracts.ResponseSuccess(c, gin.H{"items": messages})
}

func (h *Handler) DeleteSession(c *gin.Context) {
	h.mutateSession(c, false)
}

func (h *Handler) ArchiveSession(c *gin.Context) {
	h.mutateSession(c, true)
}

func (h *Handler) mutateSession(c *gin.Context, archive bool) {
	if h == nil || h.deps == nil || h.deps.CapabilityGateway == nil || !h.deps.CapabilityGateway.Enabled() {
		contracts.ResponseError(c, http.StatusServiceUnavailable, "POWERX_AGENT_GATEWAY_UNAVAILABLE", "PowerX gateway client is not configured")
		return
	}
	sessionID := strings.TrimSpace(c.Param("sessionID"))
	if sessionID == "" {
		contracts.ResponseError(c, http.StatusBadRequest, "POWERX_AGENT_SESSION_REQUIRED", "session_id is required")
		return
	}
	opts := gateway.AgentSessionMutationOptions{
		SessionID:  sessionID,
		Env:        strings.TrimSpace(c.Query("env")),
		TenantUUID: h.tenantUUID(c),
	}
	var err error
	if archive {
		err = h.deps.CapabilityGateway.ArchiveAgentSession(c.Request.Context(), opts)
	} else {
		err = h.deps.CapabilityGateway.DeleteAgentSession(c.Request.Context(), opts)
	}
	if err != nil {
		contracts.ResponseError(c, http.StatusBadGateway, "POWERX_AGENT_SESSION_MUTATION_FAILED", err.Error())
		return
	}
	contracts.ResponseSuccess(c, gin.H{"ok": true})
}

func (h *Handler) StreamSSE(c *gin.Context) {
	if h == nil || h.deps == nil || h.deps.CapabilityGateway == nil || !h.deps.CapabilityGateway.Enabled() {
		contracts.ResponseError(c, http.StatusServiceUnavailable, "POWERX_AGENT_GATEWAY_UNAVAILABLE", "PowerX gateway client is not configured")
		return
	}

	params := gateway.AgentStreamParams{
		AgentID:    firstNonEmpty(c.Query("agent_uuid"), c.Query("agent_id")),
		SessionID:  firstNonEmpty(c.Query("session_uuid"), c.Query("session_id")),
		TraceID:    strings.TrimSpace(c.Query("trace_id")),
		Query:      strings.TrimSpace(c.Query("q")),
		Intent:     strings.TrimSpace(c.Query("intent")),
		Source:     strings.TrimSpace(c.Query("source")),
		Env:        strings.TrimSpace(c.Query("env")),
		TenantUUID: h.tenantUUID(c),
	}
	stream, err := h.deps.CapabilityGateway.StreamAgentSSE(c.Request.Context(), params)
	if err != nil {
		contracts.ResponseError(c, http.StatusBadGateway, "POWERX_AGENT_STREAM_FAILED", err.Error())
		return
	}
	defer stream.Body.Close()

	_ = frameworkrealtime.ProxySSEStream(c.Request.Context(), c.Writer, frameworkrealtime.StreamThroughOptions{
		StatusCode: stream.StatusCode,
		Header:     stream.Header,
		Body:       stream.Body,
		RequestID:  stream.Header.Get("X-Request-ID"),
		TraceID:    firstNonEmpty(stream.Header.Get("X-Trace-ID"), params.TraceID),
	})
}

func parsePositiveInt(raw string, fallback int) int {
	raw = strings.TrimSpace(raw)
	if raw == "" {
		return fallback
	}
	n := 0
	for _, r := range raw {
		if r < '0' || r > '9' {
			return fallback
		}
		n = n*10 + int(r-'0')
	}
	if n <= 0 {
		return fallback
	}
	return n
}

func firstNonEmpty(values ...string) string {
	for _, value := range values {
		if strings.TrimSpace(value) != "" {
			return strings.TrimSpace(value)
		}
	}
	return ""
}

func (h *Handler) tenantUUID(c *gin.Context) string {
	if h != nil && h.deps != nil && h.deps.Config != nil {
		if h.deps.Config.Gateway != nil {
			if isGatewayAPIKeyMode(h.deps.Config.Gateway.AuthScheme, h.deps.Config.Gateway.APIKey) {
				return ""
			}
		}
		if h.deps.Config.GRPCUpstream != nil {
			if value := firstUsableTenantUUID(h.deps.Config.GRPCUpstream.TenantUUID); value != "" {
				return value
			}
		}
	}
	if value := firstUsableTenantUUID(c.GetHeader("tenant_uuid")); value != "" {
		return value
	}
	if value := firstUsableTenantUUID(c.GetHeader("X-Tenant-UUID")); value != "" {
		return value
	}
	if value := firstUsableTenantUUID(c.Query("tenant_uuid")); value != "" {
		return value
	}
	if value, ok := authx.TenantUUIDFromContext(c.Request.Context()); ok {
		if tenantUUID := firstUsableTenantUUID(value); tenantUUID != "" {
			return tenantUUID
		}
	}
	return ""
}

func isGatewayAPIKeyMode(authScheme string, apiKey string) bool {
	switch strings.ToLower(strings.TrimSpace(authScheme)) {
	case "apikey", "api_key", "api-key":
		return true
	}
	return strings.TrimSpace(apiKey) != ""
}

func isPlaceholderTenantUUID(value string) bool {
	switch strings.ToLower(strings.TrimSpace(value)) {
	case "00000000-0000-0000-0000-000000000000", "00000000-0000-0000-0000-000000000001":
		return true
	default:
		return false
	}
}

func firstUsableTenantUUID(value string) string {
	tenantUUID := strings.TrimSpace(value)
	if tenantUUID == "" || isPlaceholderTenantUUID(tenantUUID) {
		return ""
	}
	return tenantUUID
}
