id: {{ .PluginID }}.template.batch_clone
type: API
version: 1.0.0
title_i18n:
  zh-CN: 批量克隆模板
  zh: 批量克隆模板
  en: Batch Clone Templates
description: "批量克隆模板，生成多份带前缀的草稿，供后续流程批量处理。"
description_i18n:
  zh-CN: 批量克隆模板，生成多份带前缀的草稿，供后续流程批量处理。
  zh: 批量克隆模板，生成多份带前缀的草稿，供后续流程批量处理。
  en: Clone templates in batches and create prefixed drafts for later processing.
rbac:
  resource: template
  actions: [create]
provides:
  - id: schema/input/{{ .PluginID }}.template.batch_clone.v1
    path: schema/input/{{ .PluginID }}.template.batch_clone.json
    kind: input
    version: 1.0.0
  - id: schema/output/{{ .PluginID }}.template.batch_clone.v1
    path: schema/output/{{ .PluginID }}.template.batch_clone.json
    kind: output
    version: 1.0.0
metadata:
  protocols:
    rest:
      method: POST
      path: /api/v1/integration/capabilities/invoke
      description: "PowerX Gateway 统一鉴权后的插件能力入口"
    grpc:
      service: powerx.template.TemplateService
      method: BatchCloneTemplates
    workflow:
      template: contracts/exposure/workflow/template-quality-distribute.json
    agent_tool:
      id: base.template.batch_clone
      scope: agent.template.batch_clone
      transport: http
      endpoint: /api/v1/integration/capabilities/invoke
