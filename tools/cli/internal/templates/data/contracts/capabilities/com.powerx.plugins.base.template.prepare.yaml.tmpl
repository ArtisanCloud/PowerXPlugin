id: {{ .PluginID }}.template.prepare
type: API
version: 1.0.0
description: "模板对象 Skill 的执行准备能力，负责合并会话状态、判断缺参并生成后续能力调用请求。"
rbac:
  resource: template
  actions: [read]
provides:
  - id: schema/input/{{ .PluginID }}.template.prepare.v1
    path: schema/input/{{ .PluginID }}.template.prepare.json
    kind: input
    version: 1.0.0
  - id: schema/output/{{ .PluginID }}.template.prepare.v1
    path: schema/output/{{ .PluginID }}.template.prepare.json
    kind: output
    version: 1.0.0
metadata:
  protocols:
    rest:
      method: POST
      path: /api/v1/integration/capabilities/invoke
      description: "PowerX Gateway 统一鉴权后的插件能力入口"
    agent_tool:
      id: base.template.prepare
      scope: agent.template.prepare
      transport: http
      endpoint: /api/v1/integration/capabilities/invoke
