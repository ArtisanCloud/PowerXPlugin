id: {{ .PluginID }}.template.update
type: API
version: 1.0.0
title_i18n:
  zh-CN: 更新模板
  zh: 更新模板
  en: Update Template
description: "更新模板内容的原子能力，覆盖名称/描述/正文。"
description_i18n:
  zh-CN: 更新模板内容的原子能力，覆盖名称/描述/正文。
  zh: 更新模板内容的原子能力，覆盖名称/描述/正文。
  en: Update template content, including name, description, and body.
rbac:
  resource: base.templates
  actions: [update]
provides:
  - id: schema/input/{{ .PluginID }}.template.update.v1
    path: schema/input/{{ .PluginID }}.template.update.json
    kind: input
    version: 1.0.0
  - id: schema/output/{{ .PluginID }}.template.update.v1
    path: schema/output/{{ .PluginID }}.template.update.json
    kind: output
    version: 1.0.0
metadata:
  agent_response:
    content: '已更新模板「{{`{{ .template.name }}`}}」。[查看模板](/templates/crud?template_id={{`{{ .template.id }}`}})'
    links:
      - id: '{{`{{ .template.id }}`}}'
        kind: template
        label: '查看模板「{{`{{ .template.name }}`}}」'
        href: '/templates/crud?template_id={{`{{ .template.id }}`}}'
  protocols:
    rest:
      method: POST
      path: /api/v1/integration/capabilities/invoke
      description: "PowerX Gateway 统一鉴权后的插件能力入口"
    grpc:
      service: powerx.template.TemplateService
      method: UpdateTemplate
    agent_tool:
      id: base.template.update
      scope: agent.template.update
      transport: http
      endpoint: /api/v1/integration/capabilities/invoke
