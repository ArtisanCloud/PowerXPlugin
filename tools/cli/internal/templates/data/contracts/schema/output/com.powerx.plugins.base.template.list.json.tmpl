{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TemplateListOutput",
  "type": "object",
  "properties": {
    "content": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/Template" }
    },
    "links": {
      "type": "array",
      "items": { "$ref": "#/definitions/AgentResponseLink" }
    },
    "pagination": {
      "type": "object",
      "properties": {
        "page": { "type": "integer" },
        "page_size": { "type": "integer" },
        "total": { "type": "integer" }
      },
      "required": ["page", "page_size", "total"],
      "additionalProperties": false
    }
  },
  "required": ["items", "pagination"],
  "additionalProperties": false,
  "definitions": {
    "AgentResponseLink": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "label": { "type": "string" },
        "href": { "type": "string" }
      },
      "required": ["label", "href"],
      "additionalProperties": true
    },
    "Template": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"],
      "additionalProperties": true
    }
  }
}
