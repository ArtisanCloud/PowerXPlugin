{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TemplatePublishOutput",
  "type": "object",
  "properties": {
    "template_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "publish_status": {
      "type": "string",
      "enum": [
        "deployed",
        "pending",
        "failed"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "template_uuid",
    "publish_status"
  ],
  "additionalProperties": true
}
