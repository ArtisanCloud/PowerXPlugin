{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TemplateValidateOutput",
  "type": "object",
  "properties": {
    "template_uuid": {
      "type": "string",
      "format": "uuid"
    },
    "valid": {
      "type": "boolean"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "rule",
          "field",
          "severity",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "template_uuid",
    "valid",
    "violations"
  ],
  "additionalProperties": false
}
