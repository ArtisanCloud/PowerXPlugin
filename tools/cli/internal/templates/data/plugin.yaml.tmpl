id: {{ .PluginID }}
name: {{ .PluginName }}
version: {{ .Version }}
description: "PowerX 基础模板插件，提供模板 CRUD、能力注册与多协议暴露示例。"
runtime:
  kind: process
  entry: backend/bin/plugin
  env:
    POWERX_BIND_ADDR: ":__POWERX_DYNAMIC_PORT__"
    POWERX_PLUGIN_ID: {{ .PluginID }}
    POWERX_PLUGIN_REGISTRATION_MODE: installed
    POWERX_PROXY: "1"
    POWERX_PROVIDER_MODE: delegated
    POWERX_SECURITY_JWT_AUDIENCE: plugin:{{ .PluginID }}
backend:
  entry: backend/bin/plugin
  # 0 means the PowerX host allocates and injects the runtime port.
  port: 0
  health: /healthz

endpoints:
  http_base_path: /api/v1

catalogs:
  capabilities: ./plugin.d/capabilities.yaml
  exposure: ./plugin.d/exposure.yaml
  agent_tools: ./plugin.d/agent_tools.yaml
  events: ./plugin.d/events.yaml
  rbac: ./plugin.d/rbac.yaml

frontend:
  admin:
    kind: process
    process:
      entry: node
      args: ["./web-admin/.output/server/index.mjs"]
      env:
        NODE_ENV: production
        NITRO_HOST: 127.0.0.1
        POWERX_PROXY: "1"
        NUXT_PUBLIC_INSIDE_POWERX: "1"
        NUXT_PUBLIC_POWERX_PROVIDER_MODE: delegated
      health:
        http: /healthz
        interval: 5s
        timeout: 2s
    static_dir: web-admin/.output/public
    i18n:
      dir: web-admin/i18n
      format: i18next
      default_namespace: menus
      namespaces:
        - menus
      locales:
        - zh-CN
        - en
    menus:
      - id: console
        title: {{ .PluginName }}
        title_i18n:
          namespace: menus
          key: menu.{{ .PluginID }}.template
          default: {{ .PluginName }} Console
        icon: i-heroicons-clipboard-document-check
        path: /intro
        route: intro
        order: 20
        slot: group.plugins
        required_policies:
          - menu.console:view
        children:
          - id: intro
            title: {{ .PluginName }} Intro
            title_i18n:
              namespace: menus
              key: menu.{{ .PluginID }}.intro
              default: {{ .PluginName }} Intro
            icon: i-heroicons-information-circle
            path: /intro
            route: intro
            order: 1
          - id: templates
            title: 模版
            title_i18n:
              namespace: menus
              key: menu.{{ .PluginID }}.templates.title
              default: Templates
            icon: i-heroicons-clipboard-document-list
            path: /templates
            route: templates
            order: 2
            children:
              - id: develop
                title: 开发介绍
                title_i18n:
                  namespace: menus
                  key: menu.{{ .PluginID }}.templates.develop
                  default: Templates Develop Intro
                icon: i-heroicons-document-text
                path: /templates/develop
                route: templates/develop
                order: 1
              - id: crud
                title: 模版 CRUD
                title_i18n:
                  namespace: menus
                  key: menu.{{ .PluginID }}.templates.crud
                  default: Templates CRUD
                icon: i-heroicons-wrench
                path: /templates/crud
                route: templates/crud
                order: 2
              - id: framework_lab
                title: framework功能测试
                title_i18n:
                  namespace: menus
                  key: menu.{{ .PluginID }}.templates.framework_lab
                  default: Framework Function Test
                icon: i-heroicons-beaker
                path: /admin/templates/framework-lab
                route: admin/templates/framework-lab
                order: 3
                required_policies:
                  - menu.console.templates.framework_lab:view
          - id: powerx
            title: PowerX底座能力
            title_i18n:
              namespace: menus
              key: menu.{{ .PluginID }}.powerx.title
              default: {{ .PluginName }} Capabilities
            icon: i-heroicons-cpu-chip
            path: /powerx/knowledge-lab
            route: powerx/knowledge-lab
            order: 3
            required_policies:
              - menu.console.powerx:view
            children:
              - id: knowledge_lab
                title: 知识库调试
                title_i18n:
                  namespace: menus
                  key: menu.{{ .PluginID }}.powerx.knowledge_lab
                  default: Knowledge Lab
                icon: i-heroicons-circle-stack
                path: /powerx/knowledge-lab
                route: powerx/knowledge-lab
                order: 1
                required_policies:
                  - menu.console.powerx.knowledge_lab:view
assets:
  public_dir: ./web-admin/public
  webAdminPath: ./web-admin/.output

migrations:
  driver: go
  entry: backend/bin/migrate
  args: ["setup"]
  workdir: ./backend
  once: true
  timeout: 60s

checksums:
  package_sha256: ""

signature:
  enabled: false

metadata:
  author: {{ .PluginName }} Team
  license: MIT
  icon: icon.svg
