<template><main class="mx-auto w-full max-w-5xl space-y-6 px-5 py-6 lg:px-8"><section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-[#172536]"><div class="flex items-start justify-between gap-4"><div><p class="text-sm text-gray-500 dark:text-[#d6e2ff]">{{ `{{ t('knowledgeSpaces.overview.eyebrow') }}` }}</p><h1 class="mt-1 text-2xl font-semibold text-gray-900 dark:text-[#fdfcff]">{{ `{{ t('knowledgeSpaces.strategyPage.title') }}` }}</h1><p class="mt-2 text-sm text-gray-600 dark:text-[#d6e2ff]">{{ `{{ space?.name }}` }}</p></div><UButton color="neutral" variant="outline" :to="detailPath">{{ `{{ t('knowledgeSpaces.detail.backToOverview') }}` }}</UButton></div></section><section v-if="space" class="rounded-2xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-[#0f192a]"><header class="border-b border-slate-200 p-5 dark:border-slate-700"><h2 class="font-semibold text-gray-900 dark:text-[#fdfcff]">{{ `{{ t('knowledgeSpaces.ui.strategyPackage') }}` }}</h2><p class="mt-1 text-sm text-gray-600 dark:text-[#d6e2ff]">{{ `{{ t('knowledgeSpaces.strategyPage.description') }}` }}</p></header><div class="space-y-5 p-5"><UFormField :label="t('knowledgeSpaces.ui.strategyPackage')" required><USelectMenu v-model="strategyKey" :items="strategyItems" value-key="value" label-key="label" class="w-full" /></UFormField><UAlert v-if="selectedStrategy" :color="selectedStrategy.ready ? 'success' : 'warning'" variant="soft" :title="selectedStrategy.ready ? t('knowledgeSpaces.ui.strategyReady') : t('knowledgeSpaces.ui.strategyUnavailable', { requirements: selectedStrategy.missing_requirements.join(', ') })" /><div class="flex justify-end"><UButton :loading="saving" :disabled="!selectedStrategy?.ready" @click="save">{{ `{{ t('common.save') }}` }}</UButton></div></div></section></main></template>
<script setup lang="ts">
import { computed, onMounted, ref } from 'vue'
import { useLocalKnowledgeApi, type KnowledgeStrategyPackage, type LocalKnowledgeSpace } from '~/composables/api/useLocalKnowledge'
const { t } = useI18n(); const toast = useToast(); const api = useLocalKnowledgeApi(); const route = useRoute(); const runtimeConfig = useRuntimeConfig(); const space = ref<LocalKnowledgeSpace | null>(null); const strategies = ref<KnowledgeStrategyPackage[]>([]); const strategyKey = ref(''); const saving = ref(false); const uuid = computed(() => String(route.params.uuid || '')); const adminBase = computed(() => String(runtimeConfig.public?.pluginAdminBase || '/_p/com.powerx.plugins.base/admin/').replace(/\/+$/, '')); const detailPath = computed(() => `${adminBase.value}/knowledge/${uuid.value}`); const strategyItems = computed(() => strategies.value.map(item => ({ label: t(`knowledgeSpaces.strategies.${item.key}.label`), value: item.key, disabled: !item.ready }))); const selectedStrategy = computed(() => strategies.value.find(item => item.key === strategyKey.value)); function currentKey(value: LocalKnowledgeSpace) { return value.feature_flags?.find(item => item.startsWith('rag.strategy_package:'))?.replace('rag.strategy_package:', '') || '' }; async function load() { const [spaces, catalog] = await Promise.all([api.spaces(), api.strategyPackages()]); space.value = (spaces.items || []).find(item => item.uuid === uuid.value) || null; strategies.value = catalog.items || []; if (space.value) strategyKey.value = currentKey(space.value) }; async function save() { if (!space.value || !selectedStrategy.value?.ready) return; saving.value = true; try { await api.saveSpace({ uuid: space.value.uuid, name: space.value.name, department_code: space.value.department_code, strategy_package_key: strategyKey.value }); toast.add({ title: t('common.success'), description: t('knowledgeSpaces.strategyPage.saved'), color: 'success' }); await load() } catch { toast.add({ title: t('common.error'), description: t('knowledgeSpaces.strategyPage.saveFailed'), color: 'error' }) } finally { saving.value = false } }; onMounted(load)
</script>
